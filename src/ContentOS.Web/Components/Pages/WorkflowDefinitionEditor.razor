@page "/workflow-definitions"

@using System.Text.Json
@using ContentOS.Application.Commands
@using ContentOS.Application.DTOs
@using ContentOS.Application.Queries
@using MediatR
@inject IMediator Mediator

<PageTitle>Workflow Definitions | ContentOS</PageTitle>

<div class="mission-control-container workflow-definition-editor-page">
    <div class="crumb-row">
        <span>Home</span>
        <span class="crumb-sep">›</span>
        <span>Workflow Definitions</span>
    </div>

    <div class="page-header-row">
        <div>
            <h1 class="page-title">WORKFLOW DEFINITION EDITOR</h1>
            <p class="page-subtitle">Edit idea and article pipelines independently, then publish immutable versions.</p>
        </div>
        <div class="actions-group">
            <button class="btn-secondary" @onclick="ToggleJsonView">@(ShowJson ? "Edit Visual" : "View JSON")</button>
            <button class="btn-primary" @onclick="SaveDefinitionAsync" disabled="@(SelectedDefinition is null)">Save as Draft</button>
            <button class="btn-primary" @onclick="PublishDefinitionAsync" disabled="@(SelectedDefinition is null)">Publish to Production</button>
        </div>
    </div>

    <div class="workflow-definition-shell">
        <section class="dashboard-card compact-card definition-sidebar">
            <div class="widget-title">Workflow Families</div>
            @foreach (var family in Families)
            {
                <button class="family-select-btn @(SelectedFamily?.Id == family.Id ? "active" : string.Empty)" @onclick="() => SelectFamilyAsync(family.Id)">
                    <strong>@family.Name</strong>
                    <span>@family.WorkflowType</span>
                </button>
            }

            @if (SelectedFamily is not null)
            {
                <div class="widget-title" style="margin-top:1rem;">Version History</div>
                @foreach (var version in SelectedFamily.Versions.OrderByDescending(x => x.Version))
                {
                    <button class="family-select-btn @(SelectedDefinition?.Id == version.Id ? "active" : string.Empty)" @onclick="() => SelectDefinitionAsync(version.Id)">
                        <strong>v@version.Version</strong>
                        <span>@(version.IsActive ? "Active" : "Published")</span>
                    </button>
                }
            }
        </section>

        <section class="dashboard-card compact-card definition-main">
            @if (SelectedDefinition is null)
            {
                <div class="empty-card">Select a workflow definition.</div>
            }
            else if (ShowJson)
            {
                <div class="widget-title">Definition JSON Blueprint</div>
                <textarea class="definition-textarea json-editor-area" style="font-family: monospace; height: 600px; width: 100%;" @bind="JsonDefinition"></textarea>
                <div class="definition-save-row" style="margin-top:1rem;">
                    <span class="save-status">@StatusMessage</span>
                </div>
            }
            else
            {
                <div class="widget-title">@SelectedDefinition.Name</div>
                <div class="definition-meta-grid">
                    <label>
                        <span>Name</span>
                        <input @bind="SelectedDefinition.Name" />
                    </label>
                    <label>
                        <span>Description</span>
                        <textarea @bind="SelectedDefinition.Description"></textarea>
                    </label>
                    <label>
                        <span>Workflow Type</span>
                        <input value="@SelectedDefinition.WorkflowType" disabled />
                    </label>
                </div>

                <div class="definition-actions-header">
                    <h3>Actions</h3>
                    <button class="btn-secondary" @onclick="AddAction">+ Add Action</button>
                </div>

                <div class="definition-action-list">
                    @foreach (var action in SelectedDefinition.Actions.OrderBy(x => x.Order))
                    {
                        <div class="definition-action-card">
                            <div class="definition-action-top">
                                <button class="action-order-btn" @onclick="() => MoveAction(action, -1)">↑</button>
                                <button class="action-order-btn" @onclick="() => MoveAction(action, 1)">↓</button>
                                <div class="definition-action-title-block">
                                    <input class="definition-input-title" @bind="action.Name" />
                                    <input class="definition-input-subtitle" @bind="action.AssignedAgent" placeholder="Assigned agent" />
                                    <input class="definition-input-subtitle" @bind="action.CapabilityKey" placeholder="Capability key" />
                                </div>
                                <label><input type="checkbox" @bind="action.IsEnabled" /> Enabled</label>
                                <button class="btn-link btn-link-danger" @onclick="() => RemoveAction(action)">Remove</button>
                            </div>
                            <textarea class="definition-textarea" @bind="action.Instructions" placeholder="Action instructions"></textarea>

                            <div class="definition-steps-header">
                                <h4>Steps</h4>
                                <button class="btn-secondary" @onclick="() => AddStep(action)">+ Add Step</button>
                            </div>

                            <div class="definition-step-list">
                                @foreach (var step in action.Steps.OrderBy(x => x.Order))
                                {
                                    <div class="definition-step-card">
                                        <div class="definition-step-top">
                                            <button class="action-order-btn" @onclick="() => MoveStep(action, step, -1)">↑</button>
                                            <button class="action-order-btn" @onclick="() => MoveStep(action, step, 1)">↓</button>
                                            <input class="definition-input-title" @bind="step.Name" />
                                            <label><input type="checkbox" @bind="step.IsEnabled" /> Enabled</label>
                                            <button class="btn-link btn-link-danger" @onclick="() => RemoveStep(action, step)">Remove</button>
                                        </div>
                                        <input class="definition-input-subtitle" @bind="step.Purpose" placeholder="Purpose" />
                                        <input class="definition-input-subtitle" @bind="step.CapabilityKey" placeholder="Capability key" />
                                        <textarea class="definition-textarea" @bind="step.Instructions" placeholder="Step instructions"></textarea>
                                        <input class="definition-input-subtitle" @bind="step.ExpectedOutput" placeholder="Expected output" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="definition-save-row">
                    <span class="save-status">@StatusMessage</span>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private List<WorkflowDefinitionFamilyDto> Families { get; set; } = new();
    private WorkflowDefinitionFamilyDto? SelectedFamily { get; set; }
    private WorkflowDefinitionDto? SelectedDefinition { get; set; }
    private bool ShowJson { get; set; }
    private string JsonDefinition { get; set; } = "{}";
    private string StatusMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Families = (await Mediator.Send(new GetWorkflowDefinitionFamiliesQuery())).ToList();
        if (Families.Count > 0)
        {
            await SelectFamilyAsync(Families[0].Id);
        }
    }

    private async Task SelectFamilyAsync(Guid familyId)
    {
        SelectedFamily = Families.FirstOrDefault(x => x.Id == familyId);
        var definitionId = SelectedFamily?.ActiveWorkflowDefinitionId ?? SelectedFamily?.Versions.OrderByDescending(x => x.Version).FirstOrDefault()?.Id;
        if (definitionId.HasValue)
        {
            await SelectDefinitionAsync(definitionId.Value);
        }
    }

    private async Task SelectDefinitionAsync(Guid definitionId)
    {
        SelectedDefinition = await Mediator.Send(new GetWorkflowDefinitionByIdQuery(definitionId));
        UpdateJsonString();
        StatusMessage = string.Empty;
    }

    private void ToggleJsonView()
    {
        ShowJson = !ShowJson;
        UpdateJsonString();
    }

    private void UpdateJsonString()
    {
        JsonDefinition = SelectedDefinition is null ? "{}" : JsonSerializer.Serialize(SelectedDefinition, new JsonSerializerOptions { WriteIndented = true });
    }

    private async Task SaveJsonDefinitionAsync()
    {
        if (SelectedDefinition is null)
        {
            return;
        }

        var updated = JsonSerializer.Deserialize<WorkflowDefinitionDto>(JsonDefinition, new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
            ?? throw new InvalidOperationException("Invalid JSON payload.");

        SelectedDefinition = await Mediator.Send(new SaveWorkflowDefinitionCommand(updated, "Eric"));
        StatusMessage = "Draft normalized.";
        UpdateJsonString();
    }

    private async Task PublishDefinitionAsync()
    {
        if (SelectedDefinition is null)
        {
            return;
        }

        NormalizeActionOrder();
        SelectedDefinition = await Mediator.Send(new PublishWorkflowDefinitionVersionCommand(SelectedDefinition, "Eric"));
        Families = (await Mediator.Send(new GetWorkflowDefinitionFamiliesQuery())).ToList();
        SelectedFamily = Families.FirstOrDefault(x => x.Id == SelectedDefinition.WorkflowDefinitionFamilyId);
        StatusMessage = $"Published version {SelectedDefinition.Version}.";
        UpdateJsonString();
    }

    private async Task SaveDefinitionAsync()
    {
        if (SelectedDefinition is null)
        {
            return;
        }

        NormalizeActionOrder();
        SelectedDefinition = await Mediator.Send(new SaveWorkflowDefinitionCommand(SelectedDefinition, "Eric"));
        StatusMessage = "Draft normalized.";
        UpdateJsonString();
    }

    private void AddAction()
    {
        if (SelectedDefinition is null)
        {
            return;
        }

        SelectedDefinition.Actions.Add(new WorkflowActionDefinitionDto
        {
            Id = Guid.NewGuid(),
            WorkflowDefinitionId = SelectedDefinition.Id,
            Name = "New Action",
            CapabilityKey = string.Empty,
            Order = SelectedDefinition.Actions.Count + 1,
            IsEnabled = true
        });
        NormalizeActionOrder();
    }

    private void RemoveAction(WorkflowActionDefinitionDto action)
    {
        SelectedDefinition?.Actions.Remove(action);
        NormalizeActionOrder();
    }

    private void MoveAction(WorkflowActionDefinitionDto action, int delta)
    {
        if (SelectedDefinition is null)
        {
            return;
        }

        var actions = SelectedDefinition.Actions.OrderBy(x => x.Order).ToList();
        var index = actions.FindIndex(x => x.Id == action.Id);
        var newIndex = index + delta;
        if (index < 0 || newIndex < 0 || newIndex >= actions.Count)
        {
            return;
        }

        (actions[index], actions[newIndex]) = (actions[newIndex], actions[index]);
        SelectedDefinition.Actions = actions;
        NormalizeActionOrder();
    }

    private void AddStep(WorkflowActionDefinitionDto action)
    {
        action.Steps.Add(new WorkflowStepDefinitionDto
        {
            Id = Guid.NewGuid(),
            WorkflowActionDefinitionId = action.Id,
            Name = "New Step",
            CapabilityKey = string.Empty,
            Order = action.Steps.Count + 1,
            IsEnabled = true
        });
        NormalizeStepOrder(action);
    }

    private void RemoveStep(WorkflowActionDefinitionDto action, WorkflowStepDefinitionDto step)
    {
        action.Steps.Remove(step);
        NormalizeStepOrder(action);
    }

    private void MoveStep(WorkflowActionDefinitionDto action, WorkflowStepDefinitionDto step, int delta)
    {
        var steps = action.Steps.OrderBy(x => x.Order).ToList();
        var index = steps.FindIndex(x => x.Id == step.Id);
        var newIndex = index + delta;
        if (index < 0 || newIndex < 0 || newIndex >= steps.Count)
        {
            return;
        }

        (steps[index], steps[newIndex]) = (steps[newIndex], steps[index]);
        action.Steps = steps;
        NormalizeStepOrder(action);
    }

    private void NormalizeActionOrder()
    {
        if (SelectedDefinition is null)
        {
            return;
        }

        var ordered = SelectedDefinition.Actions.OrderBy(x => x.Order).ToList();
        for (var index = 0; index < ordered.Count; index++)
        {
            ordered[index].Order = index + 1;
            NormalizeStepOrder(ordered[index]);
        }

        SelectedDefinition.Actions = ordered;
        UpdateJsonString();
    }

    private static void NormalizeStepOrder(WorkflowActionDefinitionDto action)
    {
        var ordered = action.Steps.OrderBy(x => x.Order).ToList();
        for (var index = 0; index < ordered.Count; index++)
        {
            ordered[index].Order = index + 1;
        }

        action.Steps = ordered;
    }
}
