@page "/workflow-definitions"
@page "/workflow-settings/{WorkflowType}"
@using System.Text.Json
@using ContentOS.Application.Commands
@using ContentOS.Application.DTOs
@using ContentOS.Application.Queries
@using ContentOS.Infrastructure.Workflow
@using MediatR
@inject IMediator Mediator
@inject IJSRuntime JS
@inject FullWorkflowSpecificationStore SpecificationStore
@inject IEnumerable<IFullWorkflowStepHandler> StepHandlers

<PageTitle>Workflow Definitions | ContentOS</PageTitle>
<div class="mission-control-container workflow-definition-editor-page">
    <div class="crumb-row"><span>Home</span><span class="crumb-sep">›</span><span>Workflow Definitions</span></div>
    <div class="page-header-row">
        <div>
            <h1 class="page-title">Workflow Definition Editor</h1>
            <p class="page-subtitle">Edit pipeline JSON. Save a draft or deliberately publish a new version.</p>
        </div>
        <div class="actions-group">
            <button class="btn-secondary" @onclick="ValidateJson" disabled="@(SelectedDefinition is null || IsBusy || IsRestoring || RestoreDraftId.HasValue)">Validate JSON</button>
            <button class="btn-secondary" @onclick="SaveDraftAsync" disabled="@(SelectedDefinition is null || IsBusy || IsRestoring || RestoreDraftId.HasValue)">Save as Draft</button>
            <button class="btn-primary" @onclick="PublishDefinitionAsync" disabled="@(SelectedDefinition is null || IsBusy || IsRestoring || RestoreDraftId.HasValue)">Publish New Version</button>
        </div>
    </div>
    <div class="workflow-definition-shell">
        <section class="dashboard-card compact-card definition-sidebar">
            <div class="widget-title">Workflow Families</div>
            @foreach (var family in Families)
            {
                <button class="family-select-btn @(SelectedFamily?.Id == family.Id ? "active" : string.Empty)" @onclick="() => SelectFamilyAsync(family.Id)" disabled="@IsBusy">
                    <strong>@family.Name</strong><span>@family.WorkflowType</span>
                </button>
            }
            @if (SelectedFamily is not null)
            {
                <div class="widget-title" style="margin-top:1rem;">Version History</div>
                @foreach (var version in SelectedFamily.Versions.OrderByDescending(x => x.Version))
                {
                    <button class="family-select-btn @(SelectedDefinition?.Id == version.Id ? "active" : string.Empty)" @onclick="() => SelectDefinitionAsync(version.Id)" disabled="@IsBusy">
                        <strong>@($"v{version.Version}")</strong><span>@(version.IsActive ? "Active" : "Inactive")</span>
                    </button>
                }
            }
        </section>
        <section class="dashboard-card compact-card definition-main">
            @if (SelectedDefinition is null)
            {
                <div class="empty-card">Select a workflow definition.</div>
            }
            else
            {
                <div class="widget-title">@SelectedDefinition.Name · @SelectedDefinition.WorkflowType · @($"v{SelectedDefinition.Version}")</div>
                <label class="definition-json-label" for="workflow-json">Definition JSON</label>
                <textarea id="workflow-json" class="definition-textarea json-editor-area" spellcheck="false" @bind="JsonDefinition" @bind:event="oninput" disabled="@(IsBusy || IsRestoring || RestoreDraftId.HasValue)"></textarea>
                <p class="definition-draft-note">Full specifications save as inactive local versions. Publishing checks available steps. Legacy drafts stay in this browser. Earlier versions and runs remain unchanged.</p>
            }
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="workflow-task-error-banner" role="alert">@ErrorMessage</div>
            }
            <div class="definition-save-row"><span class="save-status" role="status">@StatusMessage</span></div>
        </section>
    </div>
</div>

@code {
    [Parameter] public string? WorkflowType { get; set; }
    private List<WorkflowDefinitionFamilyDto> Families = new();
    private WorkflowDefinitionFamilyDto? SelectedFamily;
    private WorkflowDefinitionDto? SelectedDefinition;
    private readonly Dictionary<Guid, string> SessionDrafts = new();
    private Guid? RestoreDraftId;
    private string JsonDefinition = "{}";
    private string StatusMessage = string.Empty;
    private string ErrorMessage = string.Empty;
    private bool IsBusy;
    private bool IsRestoring;
    private int SelectionGeneration;
    protected override async Task OnInitializedAsync()
        => Families = (await Mediator.Send(new GetWorkflowDefinitionFamiliesQuery())).ToList();
    protected override async Task OnParametersSetAsync()
    {
        var requestedType = string.Equals(WorkflowType, "ideation", StringComparison.OrdinalIgnoreCase) ? "Idea"
            : string.Equals(WorkflowType, "article", StringComparison.OrdinalIgnoreCase) ? "Article" : null;
        var family = requestedType is null ? Families.FirstOrDefault()
            : Families.FirstOrDefault(x => string.Equals(x.WorkflowType, requestedType, StringComparison.OrdinalIgnoreCase));
        if (family is not null) await SelectFamilyAsync(family.Id);
        else { SelectionGeneration++; RememberDraft(); SelectedFamily = null; SelectedDefinition = null; RestoreDraftId = null; JsonDefinition = "{}"; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (RestoreDraftId is not Guid id) return;
        var generation = SelectionGeneration;
        var initialJson = JsonDefinition;
        IsRestoring = true;
        RestoreDraftId = null;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", DraftKey(id));
            if (generation == SelectionGeneration && SelectedDefinition?.Id == id && JsonDefinition == initialJson && !string.IsNullOrWhiteSpace(saved))
            {
                JsonDefinition = saved; SessionDrafts[id] = saved;
                StatusMessage = "Saved browser draft loaded. Validate before publishing.";
            }
        }
        catch (JSException) { if (generation == SelectionGeneration) StatusMessage = "Browser draft storage is unavailable; edits remain in this session."; }
        finally { if (generation == SelectionGeneration) { IsRestoring = false; StateHasChanged(); } }
    }
    private static string DraftKey(Guid id) => $"contentos.workflow-draft.{id:D}";
    private void RememberDraft()
    {
        if (SelectedDefinition is not null && !IsRestoring && !RestoreDraftId.HasValue) SessionDrafts[SelectedDefinition.Id] = JsonDefinition;
    }
    private async Task SelectFamilyAsync(Guid familyId)
    {
        SelectedFamily = Families.FirstOrDefault(x => x.Id == familyId);
        var id = SelectedFamily?.ActiveWorkflowDefinitionId ?? SelectedFamily?.Versions.OrderByDescending(x => x.Version).FirstOrDefault()?.Id;
        if (id.HasValue) await SelectDefinitionAsync(id.Value);
        else { SelectionGeneration++; RememberDraft(); SelectedDefinition = null; RestoreDraftId = null; JsonDefinition = "{}"; }
    }
    private async Task SelectDefinitionAsync(Guid id)
    {
        var generation = ++SelectionGeneration;
        RememberDraft();
        SelectedDefinition = null; RestoreDraftId = null; IsRestoring = false;
        var definition = await Mediator.Send(new GetWorkflowDefinitionByIdQuery(id));
        var fullJson = await SpecificationStore.TryGetSourceJsonAsync(id, CancellationToken.None);
        if (generation != SelectionGeneration) return;
        SelectedDefinition = definition;
        ErrorMessage = StatusMessage = string.Empty; RestoreDraftId = null;
        if (SessionDrafts.TryGetValue(id, out var draft)) JsonDefinition = draft;
        else
        {
            JsonDefinition = fullJson ?? JsonSerializer.Serialize(SelectedDefinition, new JsonSerializerOptions { WriteIndented = true });
            if (SelectedDefinition is not null) RestoreDraftId = id;
        }
    }
    private WorkflowDefinitionDto ParseJson()
        => WorkflowDefinitionJsonEditor.ParseAndValidate(JsonDefinition, SelectedDefinition ?? throw new InvalidOperationException("Select a workflow definition."));
    private bool IsFullSpecification()
    {
        using var document = JsonDocument.Parse(JsonDefinition);
        return document.RootElement.ValueKind == JsonValueKind.Object && document.RootElement.TryGetProperty("ScoringContract", out _);
    }
    private FullWorkflowSpecification ParseFullSpecification()
    {
        var specification = FullWorkflowSpecification.Parse(JsonDefinition);
        if (SelectedFamily is null || specification.WorkflowType.ToString() != SelectedFamily.WorkflowType)
            throw new InvalidOperationException("The full specification must match the selected workflow family type.");
        return specification;
    }
    private void ValidateJson()
    {
        ErrorMessage = StatusMessage = string.Empty;
        try
        {
            if (IsFullSpecification())
            {
                var specification = ParseFullSpecification();
                var missing = specification.Actions.SelectMany(a => a.Steps).Select(s => s.CapabilityKey)
                    .Where(key => !StepHandlers.Any(handler => handler.CapabilityKey == key)).Distinct().ToArray();
                StatusMessage = missing.Length == 0 ? "Full specification is structurally valid. Nothing was published."
                    : $"Full specification is retained, but publishing is blocked by unavailable steps: {string.Join(", ", missing)}.";
            }
            else { ParseJson(); StatusMessage = "JSON is valid. Nothing was published."; }
        }
        catch (Exception ex) when (ex is JsonException or InvalidOperationException) { ErrorMessage = ex.Message; }
    }
    private async Task SaveDraftAsync()
    {
        ErrorMessage = StatusMessage = string.Empty; IsBusy = true;
        try
        {
            if (IsFullSpecification())
            {
                ParseFullSpecification();
                var saved = await SpecificationStore.ImportDraftAsync(JsonDefinition, SelectedFamily!.Id, "Eric", CancellationToken.None);
                Families = (await Mediator.Send(new GetWorkflowDefinitionFamiliesQuery())).ToList();
                SelectedFamily = Families.First(x => x.Id == saved.WorkflowDefinitionFamilyId);
                await SelectDefinitionAsync(saved.Id);
                StatusMessage = $"Saved inactive local version {saved.Version}. The active workflow is unchanged.";
                return;
            }
            var definition = ParseJson();
            await JS.InvokeVoidAsync("localStorage.setItem", DraftKey(definition.Id), JsonDefinition);
            SessionDrafts[definition.Id] = JsonDefinition;
            StatusMessage = "Draft saved in this browser. The active workflow is unchanged.";
        }
        catch (Exception ex) when (ex is JsonException or InvalidOperationException or JSException) { ErrorMessage = ex.Message; }
        finally { IsBusy = false; }
    }
    private async Task PublishDefinitionAsync()
    {
        ErrorMessage = StatusMessage = string.Empty; IsBusy = true;
        try
        {
            if (IsFullSpecification())
            {
                ParseFullSpecification();
                var existing = SelectedDefinition is null ? null : await SpecificationStore.TryGetSourceJsonAsync(SelectedDefinition.Id, CancellationToken.None);
                var savedId = existing == JsonDefinition ? SelectedDefinition!.Id
                    : (await SpecificationStore.ImportDraftAsync(JsonDefinition, SelectedFamily!.Id, "Eric", CancellationToken.None)).Id;
                await SpecificationStore.ActivateAsync(savedId, StepHandlers.Select(handler => handler.CapabilityKey).ToArray(), "Eric", CancellationToken.None);
                Families = (await Mediator.Send(new GetWorkflowDefinitionFamiliesQuery())).ToList();
                SelectedFamily = Families.First(x => x.Id == SelectedFamily!.Id);
                await SelectDefinitionAsync(savedId);
                StatusMessage = $"Published version {SelectedDefinition!.Version}. Human approval is still required for workflow outputs.";
                return;
            }
            var definition = ParseJson(); var previousId = definition.Id;
            SelectedDefinition = await Mediator.Send(new PublishWorkflowDefinitionVersionCommand(definition, "Eric"));
            SessionDrafts.Remove(previousId);
            try { await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey(previousId)); } catch (JSException) { }
            Families = (await Mediator.Send(new GetWorkflowDefinitionFamiliesQuery())).ToList();
            SelectedFamily = Families.FirstOrDefault(x => x.Id == SelectedDefinition.WorkflowDefinitionFamilyId);
            JsonDefinition = JsonSerializer.Serialize(SelectedDefinition, new JsonSerializerOptions { WriteIndented = true });
            StatusMessage = $"Published version {SelectedDefinition.Version}.";
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsBusy = false; }
    }
}
