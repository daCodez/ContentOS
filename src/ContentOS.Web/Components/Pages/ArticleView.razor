            // Intro paragraphs
            if (Assembly.Content?.Intro?.Any() == true)
                foreach (var p in Assembly.Content.Intro)
                    if (!string.IsNullOrWhiteSpace(p))
                        AddTextBlocks(blocks, p);

            // Featured image after intro (if any real assets, or fallback placeholder)
            var featuredImage = Assembly.ImageAssets?.FirstOrDefault(i => i.IsFeatured && !string.IsNullOrWhiteSpace(i.ImagePath));
            if (featuredImage != null)
                blocks.Add(new { type = "image", data = new { file = new { url = featuredImage.ImagePath }, caption = featuredImage.AltText ?? featuredImage.Title ?? "Featured image" } });
            else if (!string.IsNullOrWhiteSpace(Assembly.Title))
            {
                // Fallback: generate a placeholder hero image via Pollinations.ai
                var placeholderUrl = $"https://image.pollinations.ai/prompt/{Uri.EscapeDataString($"Professional editorial hero image for article: {Assembly.Title}")}?width=1536&height=1024&nologo=true";
                blocks.Add(new { type = "image", data = new { file = new { url = placeholderUrl }, caption = Assembly.Title } });
            }

            // Inline Table of Contents after intro/featured image
            var tocHeadings = new List<string>();
            if (Assembly.Content?.Sections?.Any() == true)
                foreach (var sec in Assembly.Content.Sections)
                {
                    if (string.IsNullOrWhiteSpace(sec.Heading)) continue;
                    if (string.Equals(sec.Heading.Trim(), "Table of Contents", StringComparison.OrdinalIgnoreCase)) continue;
                    tocHeadings.Add(sec.Heading);
                }
            if (Assembly.Content?.Conclusion?.Any() == true)
                tocHeadings.Add("Conclusion");

            if (tocHeadings.Count > 0)
            {
                blocks.Add(new { type = "header", data = new { text = "Table of Contents", level = 2 } });
                var tocItems = tocHeadings.Select(h => $"<a href=\"#{Slugify(h)}\">{h}</a>").ToList();
                blocks.Add(new { type = "list", data = new { style = "unordered", items = tocItems } });
            }

            // Article sections with supporting images inserted between sections
            var supportImages = Assembly.ImageAssets?.Where(i => !i.IsFeatured && !string.IsNullOrWhiteSpace(i.ImagePath)).ToList() ?? new List<ArticleImageAssetDto>();
            var imgIdx = 0;
            var hasRealImages = supportImages.Count > 0;
            var sectionHeadings = Assembly.Content?.Sections?.Where(s => !string.Equals(s.Heading?.Trim(), "Table of Contents", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(s.Heading)).Select(s => s.Heading).ToList() ?? new List<string>();
            if (Assembly.Content?.Sections?.Any() == true)
                foreach (var sec in Assembly.Content.Sections)
                {
                    // Skip any pre-existing "Table of Contents" section — we generate our own above
                    if (string.Equals(sec.Heading?.Trim(), "Table of Contents", StringComparison.OrdinalIgnoreCase))
                        continue;
                    if (!string.IsNullOrWhiteSpace(sec.Heading))
                        blocks.Add(new { type = "header", data = new { text = sec.Heading, level = 2 } });
                    foreach (var p in sec.Paragraphs ?? Enumerable.Empty<string>())
                        if (!string.IsNullOrWhiteSpace(p))
                            AddTextBlocks(blocks, p);
                    // Insert a supporting image after this section if available
                    if (imgIdx < supportImages.Count)
                    {
                        var img = supportImages[imgIdx++];
                        blocks.Add(new { type = "image", data = new { file = new { url = img.ImagePath }, caption = img.AltText ?? img.Title ?? $"Image {imgIdx}" } });
                    }
                    else if (!hasRealImages && !string.IsNullOrWhiteSpace(sec.Heading) && sectionHeadings.IndexOf(sec.Heading) is var idx and >= 1 and < 3)
                    {
                        // Fallback: insert up to 2 placeholder supporting images in the first few sections
                        var placeholderUrl = $"https://image.pollinations.ai/prompt/{Uri.EscapeDataString($"Editorial illustration for: {sec.Heading}")}?width=1200&height=630&nologo=true";
                        blocks.Add(new { type = "image", data = new { file = new { url = placeholderUrl }, caption = sec.Heading } });
                    }
                }

            if (Assembly.Content?.Conclusion?.Any() == true)
            {
                blocks.Add(new { type = "header", data = new { text = "Conclusion", level = 2 } });
                foreach (var p in Assembly.Content.Conclusion)
                    if (!string.IsNullOrWhiteSpace(p))
                        AddTextBlocks(blocks, p);
            }

            if (!string.IsNullOrWhiteSpace(Assembly.Content?.Cta))
                blocks.Add(new { type = "paragraph", data = new { text = $"<b>{Assembly.Content.Cta}</b>" } });

            // Append any remaining supporting images not yet placed
            while (imgIdx < supportImages.Count)
            {
                var img = supportImages[imgIdx++];
                blocks.Add(new { type = "image", data = new { file = new { url = img.ImagePath }, caption = img.AltText ?? img.Title ?? $"Image {imgIdx}" } });
            }
        }
        else if (Article != null && !string.IsNullOrWhiteSpace(Article.BodyHtml))
        {
            return Article.BodyHtml;
        }

        if (blocks.Count == 0) return "";

        var json = System.Text.Json.JsonSerializer.Serialize(new { blocks }, new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = null,
            WriteIndented = false
        });
        return json;
    }

    /// <summary>
    /// Detects list-like text and creates proper Editor.js blocks.
    /// Paragraphs starting with numbered/bullet patterns become list blocks.
    /// </summary>
    private static void AddTextBlocks(List<object> blocks, string text)
    {
        // Split text into list and non-list segments
        var lines = text.Split('\n');
        var listItems = new List<string>();
        var isOrdered = false;

        void FlushList()
        {
            if (listItems.Count > 0)
            {
                // Convert markdown links inside list items to HTML
                var rendered = listItems.Select(RenderMarkdownLinks).ToList();
                blocks.Add(new { type = "list", data = new { style = isOrdered ? "ordered" : "unordered", items = rendered } });
                listItems.Clear();
            }
        }

        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();
            if (string.IsNullOrEmpty(line)) continue;

            // Detect ordered list: "1. " or "1) "
            var orderedMatch = System.Text.RegularExpressions.Regex.Match(line, @"^\d+[.)\s]+(.+)$");
            // Detect unordered list: "- " or "* " or "• "
            var unorderedMatch = System.Text.RegularExpressions.Regex.Match(line, @"^[-*•]\s+(.+)$");

            if (orderedMatch.Success)
            {
                if (listItems.Count > 0 && !isOrdered) FlushList(); // switch from unordered to ordered
                isOrdered = true;
                listItems.Add(orderedMatch.Groups[1].Value.Trim());
            }
            else if (unorderedMatch.Success)
            {
                if (listItems.Count > 0 && isOrdered) FlushList(); // switch from ordered to unordered
                isOrdered = false;
                listItems.Add(unorderedMatch.Groups[1].Value.Trim());
            }
            else
            {
                FlushList();
                blocks.Add(new { type = "paragraph", data = new { text = RenderMarkdownLinks(line) } });
            }
        }
        FlushList();
    }

    /// <summary>
    /// Converts markdown links [text](url) to HTML &lt;a&gt; tags.
    /// Also converts **bold** and *italic* markdown to HTML.
    /// </summary>
    private static string RenderMarkdownLinks(string text)
    {
        // [link text](url) → <a href="url" target="_blank" rel="noopener">link text</a>
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\[([^\]]+)\]\(([^)]+)\)",
            "<a href=\"$2\" target=\"_blank\" rel=\"noopener\">$1</a>");

        // **bold** → <b>bold</b>
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\*\*([^*]+)\*\*",
            "<b>$1</b>");

        // *italic* → <i>italic</i> (only if not part of a bullet)
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"(?<!^)\*([^*]+)\*(?![*])",
            "<i>$1</i>");

        return text;
    }

    private async Task LoadAsync()
