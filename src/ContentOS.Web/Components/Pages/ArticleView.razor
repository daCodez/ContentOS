        var ext = cleanPath.Split('.').LastOrDefault();
        if (string.IsNullOrWhiteSpace(ext) || ext.Length > 5 || ext.Contains('/')) return "Image";

        return ext.ToUpperInvariant() switch
        {
            "JPG" => "JPEG",
            "JPEG" => "JPEG",
            "PNG" => "PNG",
            "WEBP" => "WebP",
            "GIF" => "GIF",
            "SVG" => "SVG",
