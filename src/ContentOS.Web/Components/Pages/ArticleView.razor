    private async Task RerunQaAsync() => await RunRerunAsync(new[] { "QA" }, "QA rerun requested.");

    private async Task RunRerunAsync(string[] nameHints, string successMessage)
    {
        await RunActionAsync(async () =>
        {
            var task = Tasks.FirstOrDefault(x => nameHints.Any(h => x.Name.Contains(h, StringComparison.OrdinalIgnoreCase) || x.StageName.Contains(h, StringComparison.OrdinalIgnoreCase)));
            if (task is null) throw new InvalidOperationException($"Could not find a matching task for {string.Join('/', nameHints)}.");
            var success = await Mediator.Send(new RerunWorkflowFromTaskCommand(JobId, task.DisplayOrder, "Eric"));
            if (!success) throw new InvalidOperationException("The rerun request did not complete.");
            ActionMessage = successMessage;
        });
    }

    private ContentWorkflowTask? FindTask(string hint)
        => Tasks.FirstOrDefault(x => x.Name.Contains(hint, StringComparison.OrdinalIgnoreCase) || x.StageName.Contains(hint, StringComparison.OrdinalIgnoreCase));

    private WorkflowTaskControlRequestDto BuildRequest(string reason) => new()
    {
        Reason = reason,
        CreatedBy = "Eric",
        Source = "ArticleView",
        ActorType = "User",
        CorrelationId = Guid.NewGuid().ToString("N")
    };

    private async Task RunActionAsync(Func<Task> action)
    {
        ActionMessage = string.Empty;
        ActionError = string.Empty;
        IsActing = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Article action failed for {JobId}", JobId);
            ActionError = ex.Message;
        }
        finally
        {
            IsActing = false;
        }
    }

    private static ArticleViewModel? ArticleFromAssembly(ArticleAssemblyDto asm) => new()
