@using SlateKit
@page "/article/{JobId:guid}"

@using System.Text.RegularExpressions
@using System.Text.Json
@using MediatR
@using ContentOS.Application.Abstractions
@using ContentOS.Application.Commands
@using ContentOS.Application.DTOs
@using ContentOS.Application.Queries
@using ContentOS.Domain.Entities
@using ContentOS.Domain.Enums
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore
@inject IMediator Mediator
@inject Services.ToastService Toast
@inject IWorkflowControlService WorkflowControlService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<ArticleView> Logger
@inject ContentOS.Infrastructure.ContentOsDbContext Db
@inject HttpClient Http
@implements IAsyncDisposable

<PageTitle>@(Article?.Title ?? "Article") | ContentOS</PageTitle>

@if (!string.IsNullOrWhiteSpace(ActionMessage))
{
    <SuccessBanner Message="@ActionMessage" />
}
else if (!string.IsNullOrWhiteSpace(ActionError))
{
    <InlineNotice Title="Error" Description="@ActionError" />
}

<div class="editor-shell">

    @* ── MAIN (left) ────────────────────────────────────── *@
    <div class="editor-main">

        @* Editor card *@
        <div class="editor-card">
            @* Editor body *@
            <div class="editor-body">
                <div id="@EditorElementId" class="contentos-editorjs-holder" data-editor-ready="false"></div>
            </div>
            <div style="border-top:1px solid hsl(var(--border));padding:12px 16px;">
                <ChatComposer Placeholder="Add a note about this article..."  />
            </div>
        </div>
    </div>



    @* ── SEO PANEL (right) ─────────────────────────────── *@
    <aside class="seo-panel">

        @* Top tabs *@
        <div class="seo-tabs">
            <button class="seo-tab @((ActiveTab=="seo")?"active":"")" @onclick="SetTabSeo">SEO</button>
            <button class="seo-tab @((ActiveTab=="research")?"active":"")" @onclick="SetTabResearch">Research</button>
            <button class="seo-tab @((ActiveTab=="media")?"active":"")" @onclick="SetTabMedia">Media</button>
            <button class="seo-tab @((ActiveTab=="history")?"active":"")" @onclick="SetTabHistory">History</button>
        </div>

        <div class="seo-panel-body">

        @if (ActiveTab == "seo")
        {

            @* Sub-tabs *@
            <div class="seo-subtabs">
                <button class="seo-subtab active">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Optimization
                </button>
                <button class="seo-subtab">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Checklist
                </button>
                <button class="seo-subtab">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    Notes
                </button>
            </div>

            @* SCORE BLOCK *@
            <div class="score-block">
                <div class="score-block-header">
                    <div class="score-block-title">Optimization Score</div>
                </div>
                <div class="gauge-wrap">
                    <OptimizationGauge Score="@OptimizationScore"
                                       Size="md"
                                       Label="@(PublishReady ? "Good — ready for review" : "Needs work")"
                                       AnimateOnLoad="true" />
                </div>
            </div>

            @* STATS *@
            <div class="seo-section">
                <div class="seo-section-title">Stats</div>
                <div class="score-stats">
                    <div class="score-stat">
                        <div class="score-stat-label">Words</div>
                        <div class="score-stat-value">@WordCount</div>
                        <span class="score-stat-target">target 2,000–2,500</span>
                    </div>
                    <div class="score-stat">
                        <div class="score-stat-label">Headings</div>
                        <div class="score-stat-value">@(Assembly?.Content?.Sections?.Count ?? 0)</div>
                        <span class="score-stat-target">sections</span>
                    </div>
                    <div class="score-stat">
                        <div class="score-stat-label">Internal Links</div>
                        <div class="score-stat-value">@LinksCount</div>
                        <span class="score-stat-target">target ≥ 3</span>
                    </div>
                    <div class="score-stat">
                        <div class="score-stat-label">Readability</div>
                        <div class="score-stat-value">
                            @(Assembly?.EstimatedReadTimeMinutes ?? 0)
                            <span class="badge badge-ready" style="font-size:10px;padding:1px 6px">min read</span>
                        </div>
                    </div>
                </div>
            </div>

            @* TITLE *@
            <div class="seo-section">
                <div class="seo-section-title">Title</div>
                <input type="text" class="seo-field-input" value="@Article?.Title" readonly />
                <div class="seo-field-meta">
                    <span><span class="ok">●</span> @((Article?.Title?.Length ?? 0) > 0 ? "Length good" : "Missing")</span>
                    <span>@(Article?.Title?.Length ?? 0) / 60 chars</span>
                </div>
            </div>

            @* URL SLUG *@
            <div class="seo-section">
                <div class="seo-section-title">URL Slug</div>
                <input type="text" class="seo-field-input" value="@Article?.Slug" readonly style="font-family:'JetBrains Mono',monospace;font-size:12.5px;" />
                <div class="seo-field-meta">
                    <span><span class="ok">●</span> @(string.IsNullOrWhiteSpace(Article?.Slug) ? "Missing" : "Clean & readable")</span>
                    <span>@(Article?.Slug?.Length ?? 0) chars</span>
                </div>
            </div>

            @* META DESCRIPTION *@
            <div class="seo-section">
                <div class="seo-section-title">Meta Description</div>
                <textarea class="seo-field-input" rows="3" readonly>@Article?.MetaDescription</textarea>
                <div class="seo-field-meta">
                    <span><span class="ok">●</span> @(string.IsNullOrWhiteSpace(Article?.MetaDescription) ? "Missing" : "Compelling")</span>
                    <span>@(Article?.MetaDescription?.Length ?? 0) / 160 chars</span>
                </div>
            </div>

            @* FOCUS KEYWORDS *@
            <div class="seo-section">
                <div class="seo-section-title">
                    Focus Keywords
                    <Popover Title="Keyword Analysis" Description="Guidelines for keyword usage">
                        <ChildContent>
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="cursor:help;margin-left:4px;width:14px;height:14px"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        </ChildContent>
                    </Popover>
                </div>
                <div class="kw-list" style="padding:0">
                    @foreach (var chip in KeywordChips)
                    {
                        var barClass = chip.Score >= 90 ? "primary" : chip.Score >= 70 ? "primary" : chip.Score >= 50 ? "warn" : "fail";
                        var barWidth = Math.Min(100, chip.Score);
                        <div class="kw-row @barClass" style="margin-top:8px">
                            <span class="kw-name">@chip.Keyword</span>
                            <span class="kw-bar"><span class="kw-bar-fill" style="width:@barWidth%"></span></span>
                            <span class="kw-count">@chip.ActualCount×</span>
                        </div>
                    }
                </div>
            </div>

            @* CTA RIBBON *@
            <div class="seo-cta">
                <div class="seo-cta-icon">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="seo-cta-body">
                    <div class="seo-cta-title">@(PublishReady ? "Ready for final review" : "Needs improvement")</div>
                    <div class="seo-cta-desc">@(PublishReady ? "All required SEO fields are filled and the optimization score is in the safe zone." : "Some SEO fields need attention before publishing.")</div>
                    @if (PublishReady)
                    {
                        <button class="btn btn-success btn-sm" @onclick="() => ShowPublishDialog = true" disabled="@IsActing">
                            Approve & queue publish
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>
                        <LabelDivider Label="Schedule" />
                        <DatePicker />
                    }
                </div>
            </div>

        }
        else if (ActiveTab == "research")
        {
            @* ── RESEARCH TAB — matched to supplied HTML/CSS reference ───────────────── *@

            @if (ResearchData == null)
            {
                <div class="research-empty">
                    <div class="research-empty-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </div>
                    <div class="research-empty-title">No research data available</div>
                    <div class="research-empty-desc">Run the research pipeline first to populate this panel.</div>
                </div>
            }
            else
            {
                <div class="research-summary">
                    <div class="research-summary-row">
                        <div>
                            <div class="research-stat-label">Search volume</div>
                            <div class="research-stat-value">@(ResearchData.MonthlyVolume?.ToString("N0") ?? "—") <span class="research-stat-unit">/mo</span></div>
                        </div>
                        <div>
                            <div class="research-stat-label">Difficulty</div>
                            <div class="research-stat-value"><span class="badge @DifficultyBadgeClass(ResearchData.Difficulty)">@DifficultyLabel(ResearchData.Difficulty)</span></div>
                        </div>
                        <div>
                            <div class="research-stat-label">Intent</div>
                            <div class="research-stat-value"><span class="badge badge-running">@ResearchData.SearchIntent</span></div>
                        </div>
                    </div>
                </div>

                <div class="seo-section">
                    <div class="seo-section-title">
                        Primary keyword
                        <div class="icon-actions">
                            <button title="Edit" type="button"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                        </div>
                    </div>
                    <div class="research-primary-kw">
                        <div class="research-primary-kw-label">@ResearchData.PrimaryKeyword</div>
                        <div class="research-primary-kw-meta">
                            <span><strong>@(ResearchData.MonthlyVolume?.ToString("N0") ?? "—")</strong> searches/mo</span>
                            <span class="dot-sep">·</span>
                            <span>KD <strong>@(ResearchData.Difficulty?.ToString() ?? "—")</strong></span>
                            <span class="dot-sep">·</span>
                            <span>CPC <strong>@(ResearchData.Cpc.HasValue ? $"${ResearchData.Cpc.Value:0.00}" : "—")</strong></span>
                        </div>
                    </div>
                </div>

                @if (ResearchData.SerpKeywords.Any() || ResearchData.RelatedKeywords.Any())
                {
                    <div class="seo-section">
                        <div class="seo-section-title">Related keywords</div>
                        <table class="research-table">
                            <thead>
                                <tr>
                                    <th>Keyword</th>
                                    <th class="num">Volume</th>
                                    <th class="num">KD</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ResearchData.SerpKeywords.Any())
                                {
                                    @foreach (var sk in ResearchData.SerpKeywords.Take(6))
                                    {
                                        <tr>
                                            <td>@sk.Keyword</td>
                                            <td class="num">@FormatResearchVolume(sk.AverageCount)</td>
                                            <td class="num"><span class="kd-pill @KdTone(sk.RecommendedMax)">@sk.RecommendedMax</span></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    @foreach (var kw in ResearchData.RelatedKeywords.Take(6))
                                    {
                                        <tr>
                                            <td>@kw.Keyword</td>
                                            <td class="num">—</td>
                                            <td class="num"><span class="kd-pill easy">—</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (ResearchData.FaqQuestions.Any())
                {
                    <div class="seo-section">
                        <div class="seo-section-title">People also ask</div>
                        <div class="paa-list">
                            @foreach (var q in ResearchData.FaqQuestions.Take(5))
                            {
                                <div class="paa-item @(q.IsCovered ? "covered" : "")">
                                    <div class="paa-q">
                                        @q.Question
                                        @if (q.IsCovered)
                                        {
                                            <span class="paa-covered">Covered</span>
                                        }
                                    </div>
                                    @if (!q.IsCovered)
                                    {
                                        <button class="paa-add" type="button">+ Add as H2</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (ResearchData.CompetingPages.Any())
                {
                    <div class="seo-section">
                        <div class="seo-section-title">Top competing pages</div>
                        <div class="competitors-list">
                            @foreach (var comp in ResearchData.CompetingPages.Take(3))
                            {
                                <div class="competitor-item">
                                    <div class="competitor-rank">@comp.Rank</div>
                                    <div class="competitor-body">
                                        <div class="competitor-title" title="@comp.Title">@comp.Title</div>
                                        <div class="competitor-domain">@comp.Domain</div>
                                    </div>
                                    <div class="competitor-stats">
                                        <span>@comp.WordCount.ToString("N0") words</span>
                                        <span>DA @comp.DaScore</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="seo-cta">
                    <div class="seo-cta-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </div>
                    <div class="seo-cta-body">
                        <div class="seo-cta-title">Refresh research data</div>
                        <div class="seo-cta-desc">Last pulled @ResearchData.HoursAgo hours ago. Re-run to capture today's SERP movements.</div>
                        <button class="btn btn-outline btn-sm" disabled="@IsActing" @onclick="RerunResearchAsync">
                            Re-run research
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                        </button>
                    </div>
                </div>
            }
        }
        else if (ActiveTab == "media")
        {
            @* ── MEDIA TAB — actual article-generated images ───────────────── *@
            <div class="media-upload-card">
                <div class="media-upload-head">
                    <div>
                        <div class="media-upload-eyebrow">Media Library</div>
                        <div class="media-upload-title">Upload article image</div>
                        <div class="media-upload-subtitle">Drop a JPG, PNG, GIF, or WebP image here, or browse from your device.</div>
                    </div>
                    <span class="media-upload-badge">Local storage</span>
                </div>

                <div class="media-upload-dropzone @(_selectedFile is not null ? "has-file" : string.Empty)">
                    <InputFile class="media-upload-input" OnChange="@OnFileSelected" accept="image/*" />
                    <div class="media-upload-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    </div>
                    <div class="media-upload-copy">
                        <strong>@(_selectedFile?.Name ?? "Choose an image or drag it here")</strong>
                        <span>@(_selectedFile is null ? "Supports JPG, PNG, GIF, WebP up to 10 MB" : FormatFileSize(_selectedFile.Size))</span>
                    </div>
                    <div class="media-upload-action">Browse files</div>
                </div>

                <div class="media-upload-footer">
                    <div class="media-upload-types">
                        <span>JPG</span><span>PNG</span><span>WEBP</span><span>GIF</span>
                    </div>
                    <button class="btn btn-primary btn-sm" type="button" @onclick="UploadSelectedFile" disabled="@(_selectedFile is null || _isUploading)">
                        @if (_isUploading)
                        {
                            <text>Uploading…</text>
                        }
                        else
                        {
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                            <text>Upload image</text>
                        }
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_uploadMessage))
                {
                    <div class="media-upload-message @(_uploadSuccess ? "success" : "error")">@_uploadMessage</div>
                }
            </div>


            var imageAssets = Assembly?.ImageAssets?.Where(i => !string.IsNullOrWhiteSpace(i.ImagePath)).ToList() ?? new List<ArticleImageAssetDto>();
            var featuredImage = imageAssets.FirstOrDefault(i => i.IsFeatured) ?? imageAssets.FirstOrDefault();
            var inArticleImages = imageAssets.Where(i => featuredImage == null || !ReferenceEquals(i, featuredImage)).ToList();
            var missingAltCount = imageAssets.Count(i => string.IsNullOrWhiteSpace(i.AltText));
            var withAltCount = imageAssets.Count - missingAltCount;

            @if (!imageAssets.Any())
            {
                <div class="research-empty">
                    <div class="research-empty-icon">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                    <div class="research-empty-title">No generated images found</div>
                    <div class="research-empty-desc">This article does not have saved image artifacts yet.</div>
                </div>
            }
            else
            {
                <div class="seo-section">
                    <div class="seo-section-title">Featured image</div>
                    @if (featuredImage != null)
                    {
                        <div class="media-featured">
                            <div class="media-thumb">
                                <img src="@featuredImage.ImagePath" alt="@featuredImage.AltText" />
                            </div>
                            <div class="media-featured-info">
                                <div class="media-filename" title="@featuredImage.ImagePath">@MediaFileName(featuredImage)</div>
                                <div class="media-meta-row">
                                    <span>@MediaFormat(featuredImage)</span>
                                    @if (!string.IsNullOrWhiteSpace(featuredImage.ImageRole))
                                    {
                                        <span class="dot-sep">·</span>
                                        <span>@FormatLabel(featuredImage.ImageRole)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(featuredImage.SuggestedPlacement))
                                    {
                                        <span class="dot-sep">·</span>
                                        <span>@featuredImage.SuggestedPlacement</span>
                                    }
                                </div>
                                <div class="media-actions">
                                    <button class="btn btn-outline btn-sm" type="button">Replace</button>
                                    <button class="btn btn-ghost btn-sm" type="button">Crop</button>
                                </div>
                            </div>
                        </div>

                        <div class="media-field" style="margin-top: 16px">
                            <label class="media-label">Alt text @if (string.IsNullOrWhiteSpace(featuredImage.AltText)) { <span class="media-warn">⚠ missing</span> }</label>
                            <input type="text" class="seo-field-input" value="@featuredImage.AltText" placeholder="Describe the image for accessibility and SEO…" />
                            <div class="seo-field-meta">
                                @if (string.IsNullOrWhiteSpace(featuredImage.AltText))
                                {
                                    <span><span class="fail">●</span> Required for WCAG compliance</span>
                                    <button class="link-btn" type="button">Generate with AI</button>
                                }
                                else
                                {
                                    <span><span class="ok">●</span> Alt text present</span>
                                }
                            </div>
                        </div>

                        <div class="media-field">
                            <label class="media-label">Caption</label>
                            <input type="text" class="seo-field-input" value="@(featuredImage.Title ?? string.Empty)" />
                        </div>
                    }
                </div>

                <div class="seo-section">
                    <div class="seo-section-title">
                        In-article images
                        <div class="icon-actions">
                            <button title="Add image" type="button"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
                        </div>
                    </div>
                    @if (inArticleImages.Any())
                    {
                        <div class="media-grid">
                            @foreach (var asset in inArticleImages)
                            {
                                var hasAlt = !string.IsNullOrWhiteSpace(asset.AltText);
                                <div class="media-card">
                                    <div class="media-card-thumb">
                                        <img src="@asset.ImagePath" alt="@asset.AltText" />
                                    </div>
                                    <div class="media-card-body">
                                        <div class="media-card-name" title="@asset.ImagePath">@MediaFileName(asset)</div>
                                        <div class="media-card-meta">
                                            <span class="badge @(hasAlt ? "badge-ready" : "badge-review")">@(hasAlt ? "alt ok" : "no alt")</span>
                                            <span>@MediaFormat(asset)</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="check-detail">No supporting images were generated for this article.</div>
                    }
                </div>

                <div class="seo-section">
                    <div class="seo-section-title">Image optimization</div>
                    <div class="score-stats">
                        <div class="score-stat">
                            <div class="score-stat-label">Total images</div>
                            <div class="score-stat-value">@imageAssets.Count</div>
                            <span class="score-stat-target">target ≥ 3</span>
                        </div>
                        <div class="score-stat">
                            <div class="score-stat-label">With alt text</div>
                            <div class="score-stat-value">@withAltCount / @imageAssets.Count @if (missingAltCount > 0) { <span class="score-stat-trend down">@missingAltCount missing</span> }</div>
                            <span class="score-stat-target">required: all</span>
                        </div>
                        <div class="score-stat">
                            <div class="score-stat-label">Featured image</div>
                            <div class="score-stat-value">@(featuredImage != null ? "Present" : "Missing")</div>
                            <span class="score-stat-target">hero required</span>
                        </div>
                        <div class="score-stat">
                            <div class="score-stat-label">Formats</div>
                            <div class="score-stat-value">@string.Join(" · ", imageAssets.Select(MediaFormat).Where(f => f != "Image").Distinct().DefaultIfEmpty("Image"))</div>
                            <span class="score-stat-target">actual assets</span>
                        </div>
                    </div>
                </div>

                @if (missingAltCount > 0)
                {
                    <div class="seo-cta">
                        <div class="seo-cta-icon" style="background: hsl(var(--status-review) / 0.15); color: hsl(var(--status-review))">
