    private async Task LoadResearchDataAsync()
    {
        try
        {
            var actionRuns = await Db.WorkflowActionRuns
                .Where(ar => ar.WorkflowDefinitionRunId == JobId && ar.Status == WorkflowDefinitionRunStatus.Completed)
                .ToListAsync();

            var strategyRun = actionRuns.FirstOrDefault(ar => ar.Name == "Content Strategy & Briefing");
            var researchRun = actionRuns.FirstOrDefault(ar => ar.Name == "Research, Evidence & Differentiation");

            string? searchIntent = null, contentAngle = null, painPoint = null, primaryKeyword = null;
            List<string> secondaryKeywords = new();
            List<string> faqQuestions = new();
            DateTime? lastPulled = null;
            int? seoMonthlyVolume = null;
            int? seoDifficulty = null;
            decimal? seoTrendScore = null;
            decimal? seoCpc = null;
            string? seoSourceProvider = null;
            List<TrendPointDisplay> trendPoints = new();

            // Parse from Research, Evidence & Differentiation run
            if (researchRun?.OutputSnapshotJson != null)
            {
                using var researchDoc = JsonDocument.Parse(researchRun.OutputSnapshotJson);
                var root = researchDoc.RootElement;
                if (root.TryGetProperty("researchIntent", out var ri))
                {
                    searchIntent = ri.TryGetProperty("intent", out var intentEl) ? intentEl.GetString() : null;
                    contentAngle = ri.TryGetProperty("angle", out var angleEl) ? angleEl.GetString() : null;
                    painPoint = ri.TryGetProperty("painPoint", out var ppEl) ? ppEl.GetString() : null;
                    primaryKeyword = ri.TryGetProperty("keyword", out var kwEl) ? kwEl.GetString() : null;
                }
                // New: real PAA questions from SERP research
                if (root.TryGetProperty("peopleAlsoAsk", out var paa) && paa.ValueKind == JsonValueKind.Array)
                {
                    foreach (var item in paa.EnumerateArray())
                        if (item.GetString() is { } q && !string.IsNullOrWhiteSpace(q))
                            faqQuestions.Add(q);
                }
                // New: SEO metrics from provider adapters
                if (root.TryGetProperty("seoMetrics", out var sm) && sm.ValueKind == JsonValueKind.Object)
                {
                    seoMonthlyVolume = sm.TryGetProperty("monthlyVolume", out var mv) && mv.ValueKind == JsonValueKind.Number ? mv.GetInt32() : null;
                    seoDifficulty = sm.TryGetProperty("difficulty", out var df) && df.ValueKind == JsonValueKind.Number ? df.GetInt32() : null;
                    seoTrendScore = sm.TryGetProperty("trendScore", out var ts) && ts.ValueKind == JsonValueKind.Number ? ts.GetDecimal() : null;
                    seoCpc = sm.TryGetProperty("cpc", out var cpcEl) && cpcEl.ValueKind == JsonValueKind.Number ? cpcEl.GetDecimal() : null;
                    seoSourceProvider = sm.TryGetProperty("sourceProvider", out var sp) ? sp.GetString() : null;
                }
                // New: trend data
                if (root.TryGetProperty("trendData", out var td) && td.ValueKind == JsonValueKind.Object)
                {
                    if (td.TryGetProperty("points", out var tps) && tps.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var tp in tps.EnumerateArray())
                        {
                            trendPoints.Add(new TrendPointDisplay
                            {
                                Date = tp.TryGetProperty("date", out var d) ? d.GetString() ?? "" : "",
                                Value = tp.TryGetProperty("value", out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0
                            });
                        }
                    }
                }
                lastPulled = researchRun.CompletedUtc;
            }

            // Parse from Content Strategy & Briefing run (supplemental / override)
            if (strategyRun?.OutputSnapshotJson != null)
            {
                using var strategyDoc = JsonDocument.Parse(strategyRun.OutputSnapshotJson);
                var root = strategyDoc.RootElement;

                // researchIntent may also be present here
                if (root.TryGetProperty("researchIntent", out var ri2))
                {
                    searchIntent ??= ri2.TryGetProperty("intent", out var i2) ? i2.GetString() : null;
                    contentAngle ??= ri2.TryGetProperty("angle", out var a2) ? a2.GetString() : null;
                    painPoint ??= ri2.TryGetProperty("painPoint", out var p2) ? p2.GetString() : null;
                    primaryKeyword ??= ri2.TryGetProperty("keyword", out var k2) ? k2.GetString() : null;
                }

                // keywordStrategy
                if (root.TryGetProperty("keywordStrategy", out var ks))
                {
                    primaryKeyword ??= ks.TryGetProperty("PrimaryKeyword", out var pk) ? pk.GetString() : null;
                    if (ks.TryGetProperty("SecondaryKeywords", out var sk) && sk.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var item in sk.EnumerateArray())
                            if (item.GetString() is { } s && !string.IsNullOrWhiteSpace(s))
                                secondaryKeywords.Add(s);
                    }
                    if (ks.TryGetProperty("FaqQuestions", out var fq) && fq.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var item in fq.EnumerateArray())
                            if (item.GetString() is { } q && !string.IsNullOrWhiteSpace(q))
                                faqQuestions.Add(q);
                    }
                    searchIntent ??= ks.TryGetProperty("IntentMatch", out var im) ? im.GetString() : null;
                }

                // contentBrief.FaqQuestions (fallback)
                if (faqQuestions.Count == 0 && root.TryGetProperty("contentBrief", out var cb))
                {
                    // no FaqQuestions on contentBrief itself, skip
                }

                // topicExpansion.MustAnswerQuestions (fallback)
                if (faqQuestions.Count == 0 && root.TryGetProperty("topicExpansion", out var te))
                {
                    if (te.TryGetProperty("MustAnswerQuestions", out var maq) && maq.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var item in maq.EnumerateArray())
                            if (item.GetString() is { } q && !string.IsNullOrWhiteSpace(q))
                                faqQuestions.Add(q);
                    }
                }

                lastPulled ??= strategyRun.CompletedUtc;
            }

            if (searchIntent != null || primaryKeyword != null)
            {
                // Determine FAQ coverage from article headings
                var articleHeadings = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                if (Assembly?.Content?.Sections != null)
                    foreach (var sec in Assembly.Content.Sections)
                        if (!string.IsNullOrWhiteSpace(sec.Heading))
                            articleHeadings.Add(sec.Heading);

                // Build competing pages from SerpBenchmark artifact
                var competingPages = new List<ResearchCompetingPage>();
                var serpArtifact = await Db.ContentArtifacts
                    .Where(a => a.ContentWorkflowJobId == JobId && a.ArtifactType == "SerpBenchmark")
                    .OrderByDescending(a => a.CreatedUtc)
                    .FirstOrDefaultAsync();
                List<ResearchSerpKeyword> serpKeywords = new();
                if (serpArtifact?.ContentJson != null)
                {
                    try
                    {
                        using var serpDoc = JsonDocument.Parse(serpArtifact.ContentJson);
                        var resultsArr = serpDoc.RootElement.TryGetProperty("results", out var ra) ? ra : default;
                        if (resultsArr.ValueKind == JsonValueKind.Array)
                        {
                            var rank = 1;
                            foreach (var r in resultsArr.EnumerateArray())
                            {
                                if (rank > 5) break;
                                competingPages.Add(new ResearchCompetingPage
                                {
                                    Rank = rank++,
                                    Title = r.TryGetProperty("title", out var t) ? t.GetString() ?? "" : "",
                                    Domain = r.TryGetProperty("domain", out var d) ? (d.GetString() ?? "") : r.TryGetProperty("url", out var u) ? (u.GetString() ?? "").Split('/').ElementAtOrDefault(2) ?? "" : "",
                                    WordCount = r.TryGetProperty("wordCount", out var wc) ? wc.GetInt32() : 0,
                                    DaScore = r.TryGetProperty("domainAuthority", out var da) ? da.GetInt32() : 0
                                });
                            }
                        }
                        // SERP related keywords (real benchmark data)
                        if (serpDoc.RootElement.TryGetProperty("relatedKeywords", out var rks) && rks.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var rk in rks.EnumerateArray())
                            {
                                serpKeywords.Add(new ResearchSerpKeyword
                                {
                                    Keyword = rk.TryGetProperty("keyword", out var kw) ? kw.GetString() ?? "" : "",
                                    AverageCount = rk.TryGetProperty("averageCount", out var ac) ? ac.GetDecimal() : 0,
                                    RecommendedMin = rk.TryGetProperty("recommendedMin", out var rmin) ? rmin.GetInt32() : 0,
                                    RecommendedMax = rk.TryGetProperty("recommendedMax", out var rmax) ? rmax.GetInt32() : 0
                                });
                            }
                        }
                        lastPulled ??= serpArtifact.CreatedUtc;
                    }
                    catch { /* skip SERP parse failures */ }
                }

                // Also load PeopleAlsoAsk artifact (persisted separately)
                var paaArtifact = await Db.ContentArtifacts
                    .Where(a => a.ContentWorkflowJobId == JobId && a.ArtifactType == "PeopleAlsoAsk")
                    .OrderByDescending(a => a.CreatedUtc)
                    .FirstOrDefaultAsync();
                if (paaArtifact?.ContentJson != null && faqQuestions.Count == 0)
                {
                    try
                    {
                        using var paaDoc = JsonDocument.Parse(paaArtifact.ContentJson);
                        if (paaDoc.RootElement.TryGetProperty("questions", out var qs) && qs.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var item in qs.EnumerateArray())
                                if (item.GetString() is { } q && !string.IsNullOrWhiteSpace(q))
                                    faqQuestions.Add(q);
                        }
                    }
                    catch { /* skip */ }
                }

                // Build richer related keywords from topic expansion subtopics
                var relatedKeywords = new List<ResearchRelatedKeyword>();
                foreach (var sk in secondaryKeywords)
                    relatedKeywords.Add(new ResearchRelatedKeyword
                    {
                        Keyword = sk,
                        Intent = searchIntent ?? "Informational",
                        Angle = contentAngle != null ? char.ToUpper(contentAngle[0]) + contentAngle[1..] : "General"
                    });

                // Also add subtopics as related keywords for richer data
                if (strategyRun?.OutputSnapshotJson != null)
                {
                    try
                    {
                        using var sDoc = JsonDocument.Parse(strategyRun.OutputSnapshotJson);
                        if (sDoc.RootElement.TryGetProperty("topicExpansion", out var te) &&
                            te.TryGetProperty("Subtopics", out var subs) && subs.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var sub in subs.EnumerateArray())
                            {
                                var subText = sub.GetString();
                                if (!string.IsNullOrWhiteSpace(subText) && !relatedKeywords.Any(rk => string.Equals(rk.Keyword, subText, StringComparison.OrdinalIgnoreCase)))
                                    relatedKeywords.Add(new ResearchRelatedKeyword
                                    {
                                        Keyword = char.ToUpper(subText[0]) + subText[1..],
                                        Intent = searchIntent ?? "Informational",
                                        Angle = contentAngle != null ? char.ToUpper(contentAngle[0]) + contentAngle[1..] : "General"
                                    });
                            }
                        }
                    }
                    catch { /* skip */ }
                }

                // If no FAQ from action runs, generate from topic expansion
                if (faqQuestions.Count == 0 && strategyRun?.OutputSnapshotJson != null)
                {
                    try
                    {
                        using var sDoc = JsonDocument.Parse(strategyRun.OutputSnapshotJson);
                        if (sDoc.RootElement.TryGetProperty("topicExpansion", out var te) &&
                            te.TryGetProperty("MustAnswerQuestions", out var maq) && maq.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var item in maq.EnumerateArray())
                                if (item.GetString() is { } q && !string.IsNullOrWhiteSpace(q))
                                    faqQuestions.Add(q);
                        }
                    }
                    catch { /* skip */ }
                }

                ResearchData = new ResearchPanelData
                {
                    SearchIntent = searchIntent ?? "Unknown",
                    ContentAngle = contentAngle != null ? char.ToUpper(contentAngle[0]) + contentAngle[1..] : "General",
                    PainPoint = painPoint ?? "Not specified",
                    PrimaryKeyword = primaryKeyword ?? Article?.Title ?? "Untitled",
                    RelatedKeywords = relatedKeywords,
                    FaqQuestions = faqQuestions.Select(q => new ResearchFaqQuestion
                    {
                        Question = q,
                        IsCovered = articleHeadings.Any(h => h.IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0 || q.IndexOf(h, StringComparison.OrdinalIgnoreCase) >= 0)
                    }).ToList(),
                    CompetingPages = competingPages,
                    SerpKeywords = serpKeywords,
                    MonthlyVolume = seoMonthlyVolume,
                    Difficulty = seoDifficulty,
                    TrendScore = seoTrendScore,
                    Cpc = seoCpc,
                    SeoSourceProvider = seoSourceProvider,
                    TrendPoints = trendPoints,
                    LastPulledUtc = lastPulled
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load research data for {JobId}", JobId);
        }
    }

    private async Task RerunResearchAsync()
    {
        await RunRerunAsync(new[] { "Research", "Content Strategy", "Briefing" }, "Research rerun requested.");
    }

    private sealed class ResearchPanelData
    {
        public string SearchIntent { get; set; } = string.Empty;
        public string ContentAngle { get; set; } = string.Empty;
        public string PainPoint { get; set; } = string.Empty;
        public string PrimaryKeyword { get; set; } = string.Empty;
        public List<ResearchRelatedKeyword> RelatedKeywords { get; set; } = new();
        public List<ResearchSerpKeyword> SerpKeywords { get; set; } = new();
        public List<ResearchFaqQuestion> FaqQuestions { get; set; } = new();
        public List<ResearchCompetingPage> CompetingPages { get; set; } = new();
        // SEO metrics from provider adapters
        public int? MonthlyVolume { get; set; }
        public int? Difficulty { get; set; }
        public decimal? TrendScore { get; set; }
        public decimal? Cpc { get; set; }
        public string? SeoSourceProvider { get; set; }
        // Trend data
        public List<TrendPointDisplay> TrendPoints { get; set; } = new();
        public DateTime? LastPulledUtc { get; set; }
        public int HoursAgo => LastPulledUtc.HasValue ? (int)(DateTime.UtcNow - LastPulledUtc.Value).TotalHours : 0;
    }

    private sealed class ResearchRelatedKeyword
    {
        public string Keyword { get; set; } = string.Empty;
        public string Intent { get; set; } = string.Empty;
        public string Angle { get; set; } = string.Empty;
    }

    private sealed class ResearchSerpKeyword
    {
        public string Keyword { get; set; } = string.Empty;
        public decimal AverageCount { get; set; }
        public int RecommendedMin { get; set; }
        public int RecommendedMax { get; set; }
    }

    private sealed class ResearchFaqQuestion
    {
        public string Question { get; set; } = string.Empty;
        public bool IsCovered { get; set; }
    }

    private sealed class ResearchCompetingPage
    {
        public int Rank { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Domain { get; set; } = string.Empty;
        public int WordCount { get; set; }
        public int DaScore { get; set; }
    }

    private sealed class TrendPointDisplay
    {
        public string Date { get; set; } = string.Empty;
        public decimal Value { get; set; }
    }

    // ── Image upload state & handlers ──
    private IBrowserFile? _selectedFile;
    private bool _isUploading;
    private string _uploadMessage = "";
    private bool _uploadSuccess;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _uploadMessage = "";
    }


    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / 1024d / 1024d:0.#} MB selected";
        }

        return $"{Math.Max(1, bytes / 1024)} KB selected";
    }

    private async Task UploadSelectedFile()
    {
        if (_selectedFile is null) return;
        _isUploading = true;
        _uploadMessage = "";
        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", _selectedFile.Name);
            content.Add(new StringContent(JobId.ToString()), "jobId");
            content.Add(new StringContent("manual-upload"), "requestedBy");

            var response = await Http.PostAsync("api/v1/artifacts/upload-image", content);
            if (response.IsSuccessStatusCode)
            {
                _uploadSuccess = true;
                _uploadMessage = "Image uploaded successfully.";
                await LoadAsync();
            }
            else
            {
                _uploadSuccess = false;
                _uploadMessage = $"Upload failed: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            _uploadSuccess = false;
            _uploadMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isUploading = false;
        }
    }
}