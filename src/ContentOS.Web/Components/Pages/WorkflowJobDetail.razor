        var payload = ParseArtifactJson(FinalArticlePreview.ContentJson);
        if (payload is null)
        {
            EditorModel = null;
            return;
        }

        var htmlBody = GetJsonString(payload, "htmlBody");
        var editorJson = GetJsonString(payload, "editorJson");

        // Prefer Editor.js JSON as source of truth; fall back to HTML
        var bodyForEditor = !string.IsNullOrWhiteSpace(editorJson) ? editorJson : htmlBody;

        if (string.IsNullOrWhiteSpace(bodyForEditor))
        {
            htmlBody = BuildHtmlBody(payload);
            bodyForEditor = htmlBody;
        }
        else if (string.IsNullOrWhiteSpace(htmlBody))
        {
            htmlBody = BuildHtmlBody(payload);
        }

        EditorModel = new FinalArticleEditorModel
        {
            ArtifactId = FinalArticlePreview.Id,
            Title = GetJsonString(payload, "title"),
            Slug = GetJsonString(payload, "slug"),
            Summary = GetJsonString(payload, "summary"),
            MetaDescription = GetJsonString(payload, "metaDescription"),
            PrimaryKeyword = GetJsonString(payload, "primaryKeyword"),
            KeywordStrengthLabel = GetJsonString(payload, "keywordStrengthLabel"),
            KeywordStrengthScore = GetJsonString(payload, "keywordStrengthScore"),
            KeywordStrengthReason = GetJsonString(payload, "keywordStrengthReason"),
            ContentType = GetJsonString(payload, "contentType"),
            TargetWordCountMin = GetJsonString(payload, "targetWordCountMin"),
            TargetWordCountMax = GetJsonString(payload, "targetWordCountMax"),
            EstimatedWordCount = GetJsonString(payload, "estimatedWordCount"),
            EstimatedReadTimeMinutes = GetJsonString(payload, "estimatedReadTimeMinutes"),
            CallToAction = GetJsonString(payload, "callToAction"),
            BodyHtml = htmlBody,
            EditorJson = editorJson
        };

        ShouldHydrateEditor = ActiveTab == WorkflowTab.FinalArticle;
        _lastSavedHtml = htmlBody;
    }

