@page "/workflow-job/{JobId:guid}"

@using System.Text.Json
@using System.Net.Http.Json
@using System.Threading;
@using MediatR
@using ContentOS.Application.Commands.Artifacts
@using ContentOS.Application.Commands
@using ContentOS.Application.Queries
@using ContentOS.Domain.Entities
@using TaskStatusEnum = ContentOS.Domain.Enums.TaskStatus
@inject IMediator Mediator
@inject IJSRuntime JS
@inject HttpClient Http
@implements IAsyncDisposable

<PageTitle>Workflow Detail | ContentOS</PageTitle>

<div class="mission-control-container">
    <div class="crumb-row">
        <span>Home</span>
        <span class="crumb-sep">›</span>
        <a href="/research-inbox">Research Inbox</a>
        <span class="crumb-sep">›</span>
        <span>Workflow</span>
    </div>

    <div class="page-header-row">
        <div>
            <h1 class="page-title">WORKFLOW DETAIL</h1>
            <p class="page-subtitle">Track the production pipeline for this approved topic.</p>
        </div>
        <div class="actions-group">
            @if (FinalArticlePreview is not null)
            {
                <a href="@($"/workflow-job/{JobId}/preview")" class="btn-primary">Read Mode</a>
            }
            <a href="/research-inbox" class="btn-secondary">Back to Inbox</a>
        </div>
    </div>

    @if (Job is null)
    {
        <div class="empty-card">Workflow not found.</div>
    }
    else
    {
        <div class="workflow-tab-bar" role="tablist" aria-label="Workflow detail sections">
            <button class="workflow-tab @(ActiveTab == WorkflowTab.Overview ? "workflow-tab-active" : string.Empty)" @onclick='() => SetActiveTab(WorkflowTab.Overview)'>Overview</button>
            <button class="workflow-tab @(ActiveTab == WorkflowTab.Tasks ? "workflow-tab-active" : string.Empty)" @onclick='() => SetActiveTab(WorkflowTab.Tasks)'>Tasks</button>
            <button class="workflow-tab @(ActiveTab == WorkflowTab.Artifacts ? "workflow-tab-active" : string.Empty)" @onclick='() => SetActiveTab(WorkflowTab.Artifacts)'>Artifacts</button>
            <button class="workflow-tab @(ActiveTab == WorkflowTab.FinalArticle ? "workflow-tab-active" : string.Empty)" @onclick='() => SetActiveTab(WorkflowTab.FinalArticle)'>Editorial Mode</button>
        </div>

        @if (ActiveTab == WorkflowTab.Overview)
        {
            <div class="summary-grid">
                <div class="summary-card hero-card">
                    <div class="eyebrow">Workflow Job</div>
                    <h2>@Job.Id</h2>
                    <p>@(Idea?.Title ?? "Approved topic workflow")</p>
                    <div class="tag-row">
                        <span class="status-badge @(MapJobStatusClass(Job.Status))">@Job.Status</span>
                        <span class="badge-neutral">@Job.CurrentStage</span>
                        @if (!string.IsNullOrWhiteSpace(Idea?.ContentType))
                        {
                            <span class="badge-blue">@FormatLabel(Idea.ContentType)</span>
                        }
                    </div>
                </div>

                <div class="summary-card">
                    <div class="eyebrow">Current Snapshot</div>
                    <div class="detail-pair">
                        <span class="label">Topic</span>
                        <p>@(Idea?.Title ?? "Unknown")</p>
                    </div>
                    <div class="detail-pair">
                        <span class="label">Current stage</span>
                        <p>@Job.CurrentStage</p>
                    </div>
                    <div class="detail-pair">
                        <span class="label">Definition version</span>
                        <p>@(WorkflowVersionInfo is null ? "Unknown" : $"{WorkflowVersionInfo.WorkflowDefinitionName} v{WorkflowVersionInfo.WorkflowDefinitionVersion}")</p>
                    </div>
                    <div class="detail-pair">
                        <span class="label">Last updated</span>
                        <p>@Job.LastUpdatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
                    </div>
                </div>

                <div class="summary-card focus-card">
                    <div class="eyebrow">Focus Now</div>
                    @if (CurrentTask is null)
                    {
                        <p class="focus-empty">No active step right now.</p>
                    }
                    else
                    {
                        <div class="focus-task-name">@CurrentTask.Name</div>
                        <div class="workflow-task-meta">@CurrentTask.StageName • @CurrentTask.AssignedAgent</div>
                        <div class="tag-row compact-tags">
                            <span class="status-badge @(MapTaskStatusClass(CurrentTask.Status))">@CurrentTask.Status</span>
                            <span class="badge-neutral">Step @CurrentTask.DisplayOrder</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(CurrentTask.Instructions))
                        {
                            <p class="focus-task-copy">@CurrentTask.Instructions</p>
                        }
                    }
                </div>
            </div>

            <section class="dashboard-card compact-card workflow-progress-card">
                <div class="widget-title">Progress Snapshot</div>
                <div class="mini-metrics workflow-progress-metrics">
                    <div class="mini-metric">
                        <span class="mini-label">Tasks</span>
                        <strong>@TaskCount</strong>
                    </div>
                    <div class="mini-metric active-metric">
                        <span class="mini-label">Ready Now</span>
                        <strong>@ReadyCount</strong>
                    </div>
                    <div class="mini-metric">
                        <span class="mini-label">In Progress</span>
                        <strong>@InProgressCount</strong>
                    </div>
                    <div class="mini-metric">
                        <span class="mini-label">Completed</span>
                        <strong>@CompletedCount</strong>
                    </div>
                    <div class="mini-metric">
                        <span class="mini-label">Pending</span>
                        <strong>@PendingCount</strong>
                    </div>
                </div>
            </section>

            @if (FinalArticlePreview is not null)
            {
                var preview = ParseArtifactJson(FinalArticlePreview.ContentJson);
                <section class="dashboard-card compact-card final-article-card">
                    <div class="widget-title">Final Article</div>
                    <div class="final-article-meta">
                        <div class="mini-metric">
                            <span class="mini-label">Words</span>
                            <strong>@GetJsonString(preview, "estimatedWordCount")</strong>
                        </div>
                        <div class="mini-metric">
                            <span class="mini-label">Read time</span>
                            <strong>@GetJsonString(preview, "estimatedReadTimeMinutes") min</strong>
                        </div>
                        <div class="mini-metric">
                            <span class="mini-label">Title</span>
                            <strong>@GetJsonString(preview, "title")</strong>
                        </div>
                        <div class="mini-metric">
                            <span class="mini-label">Keyword strength</span>
                            <strong class="keyword-strength @MapKeywordStrengthClass(GetJsonString(preview, "keywordStrengthLabel"))">
                                @GetJsonString(preview, "keywordStrengthLabel") (@GetJsonString(preview, "keywordStrengthScore"))
                            </strong>
                        </div>
                        <div class="mini-metric">
                            <span class="mini-label">Preview</span>
                            <strong><a class="btn-link" href="@($"/workflow-job/{JobId}/preview")">Open Read Mode</a></strong>
                        </div>
                    </div>
                    <p class="final-article-summary">@GetJsonString(preview, "summary")</p>
                </section>
            }
        }
        else if (ActiveTab == WorkflowTab.Tasks)
        {
            <section class="dashboard-card compact-card">
                <div class="widget-title">Pipeline Tasks</div>

                @if (Tasks is null)
                {
                    <p class="text-center">Loading workflow tasks...</p>
                }
                else if (!Tasks.Any())
                {
                    <p class="text-center">No tasks found for this workflow.</p>
                }
                else
                {
                    <div class="workflow-task-list">
                        @foreach (var task in OrderedTasks)
                        {
                                <div class="workflow-task-card @(task.Status == TaskStatusEnum.Ready ? "workflow-task-ready" : string.Empty) @(task.Status == TaskStatusEnum.Failed ? "workflow-task-failed" : string.Empty)">
                                <div class="workflow-task-top">
                                    <div class="workflow-task-info">
                                        <div class="workflow-task-order">Step @task.DisplayOrder</div>
                                        <div class="workflow-task-name">@task.Name</div>
                                        <div class="workflow-task-meta">@task.StageName • @task.AssignedAgent</div>
                                    </div>
                                    <div class="workflow-task-status-group">
                                        <span class="status-badge @(MapTaskStatusClass(task.Status))">@task.Status</span>
                                        @if (task.Status == TaskStatusEnum.Failed || task.Status == TaskStatusEnum.Blocked)
                                        {
                                            <button class="btn-retry-sm" @onclick="() => RetryTask(task)">Retry from here</button>
                                        }
                                        else if (task.Status == TaskStatusEnum.Completed)
                                        {
                                            <button class="btn-rerun-sm" @onclick="() => RetryTask(task)">Rerun from here</button>
                                        }
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(task.ErrorMessage))
                                {
                                    <div class="workflow-task-error-banner">
                                        <span class="error-label">Error:</span> @task.ErrorMessage
                                    </div>
                                }

                                <details class="workflow-task-detail">
                                    <summary>Details</summary>
                                    <div class="workflow-task-body">
                                        <div class="workflow-task-block">
                                            <span class="label">Instructions</span>
                                            <p>@(string.IsNullOrWhiteSpace(task.Instructions) ? "No instructions saved yet." : task.Instructions)</p>
                                        </div>
                                        <div class="workflow-task-block">
                                            <span class="label">Output</span>
                                            <div class="artifact-placeholder">@FormatJsonBlock(task.OutputDataJson)</div>
                                        </div>
                                    </div>
                                </details>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        else if (ActiveTab == WorkflowTab.Artifacts)
        {
            <section class="dashboard-card compact-card">
                <div class="widget-title">Generated Artifacts</div>

                @if (Artifacts is null)
                {
                    <p class="text-center">Loading artifacts...</p>
                }
                else if (!Artifacts.Any())
                {
                    <p class="text-center">No artifacts generated yet.</p>
                }
                else
                {
                    <div class="workflow-artifact-list">
                        @foreach (var artifact in VisibleArtifacts)
                        {
                            var payload = ParseArtifactJson(artifact.ContentJson);
                            <div class="workflow-artifact-card">
                                <div class="workflow-artifact-top">
                                    <div>
                                        <div class="workflow-task-order">@artifact.ArtifactType</div>
                                        <div class="workflow-task-name">@artifact.Title</div>
                                        <div class="workflow-task-meta">@artifact.CreatedByAgent • @artifact.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                                    </div>
                                </div>

                                <p class="artifact-summary-copy">@GetArtifactSummary(artifact, payload)</p>

                                <details class="artifact-detail">
                                    <summary>Open details</summary>
                                    @if (artifact.ArtifactType == "ContentBrief")
                                    {
                                        <div class="artifact-preview-grid">
                                            <div class="artifact-preview-block">
                                                <span class="label">Working title</span>
                                                <p>@GetJsonString(payload, "workingTitle")</p>
                                            </div>
                                            <div class="artifact-preview-block full-span">
                                                <span class="label">Brief</span>
                                                <ul class="artifact-list">
                                                    @foreach (var item in GetJsonArray(payload, "brief"))
                                                    {
                                                        <li>@item</li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                    else if (artifact.ArtifactType == "ArticleOutline")
                                    {
                                        <div class="artifact-preview-grid">
                                            <div class="artifact-preview-block full-span">
                                                <span class="label">Headline</span>
                                                <p>@GetJsonString(payload, "headline")</p>
                                            </div>
                                            <div class="artifact-preview-block full-span">
                                                <span class="label">Sections</span>
                                                <ol class="artifact-list artifact-list-numbered">
                                                    @foreach (var item in GetJsonArray(payload, "sections"))
                                                    {
                                                        <li>@item</li>
                                                    }
                                                </ol>
                                            </div>
                                        </div>
                                    }
                                    else if (artifact.ArtifactType == "DraftArticle")
                                    {
                                        <div class="artifact-preview-grid">
                                            <div class="artifact-preview-block">
                                                <span class="label">Estimated words</span>
                                                <p>@GetJsonString(payload, "estimatedWordCount")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Read time</span>
                                                <p>@GetJsonString(payload, "estimatedReadTimeMinutes") min</p>
                                            </div>
                                            <div class="artifact-preview-block full-span">
                                                <span class="label">Draft preview</span>
                                                <p>@TruncateText(GetJsonString(payload, "intro"), 280)</p>
                                            </div>
                                        </div>
                                    }
                                    else if (artifact.ArtifactType == "AiseoOptimizationReport")
                                    {
                                        <div class="artifact-preview-grid">
                                            <div class="artifact-preview-block">
                                                <span class="label">Optimized</span>
                                                <p>@(GetJsonBool(payload, "optimized") ? "Yes" : "No")</p>
                                            </div>
                                            <div class="artifact-preview-block full-span">
                                                <span class="label">AISEO notes</span>
                                                <ul class="artifact-list">
                                                    @foreach (var item in GetJsonArray(payload, "notes"))
                                                    {
                                                        <li>@item</li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                    else if (artifact.ArtifactType == "PublishPackage")
                                    {
                                        <div class="artifact-preview-grid">
                                            <div class="artifact-preview-block">
                                                <span class="label">Title</span>
                                                <p>@GetJsonString(payload, "title")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Slug</span>
                                                <p>@GetJsonString(payload, "slug")</p>
                                            </div>
                                        </div>
                                    }
                                    else if (artifact.ArtifactType == "FeaturedImageAsset" || artifact.ArtifactType == "SupportingImageAsset")
                                    {
                                        <div class="artifact-preview-grid">
                                            <div class="artifact-preview-block">
                                                <span class="label">Role</span>
                                                <p>@GetJsonString(payload, "imageRole")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Status</span>
                                                <p>@GetJsonString(payload, "status")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Aspect ratio</span>
                                                <p>@GetJsonString(payload, "aspectRatio")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Dimensions</span>
                                                <p>@GetJsonString(payload, "width") × @GetJsonString(payload, "height")</p>
                                            </div>
                                            <div class="artifact-preview-block full-span">
                                                <span class="label">Prompt</span>
                                                <p>@GetJsonString(payload, "prompt")</p>
                                            </div>
                                            <div class="artifact-preview-block full-span">
                                                <span class="label">Alt text</span>
                                                <p>@GetJsonString(payload, "altText")</p>
                                            </div>
                                        </div>
                                    }
                                    else if (artifact.ArtifactType == "SerpBenchmark")
                                    {
                                        <div class="artifact-preview-grid">
                                            <div class="artifact-preview-block">
                                                <span class="label">Results analyzed</span>
                                                <p>@GetJsonString(payload, "resultCount")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Average words</span>
                                                <p>@GetJsonString(payload, "averageWordCount")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Primary keyword avg</span>
                                                <p>@GetJsonString(payload, "averagePrimaryKeywordCount")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Recommended words</span>
                                                <p>@GetJsonString(payload, "recommendedWordCountMin")-@GetJsonString(payload, "recommendedWordCountMax")</p>
                                            </div>
                                            <div class="artifact-preview-block full-span">
                                                <span class="label">Related keyword targets</span>
                                                <div class="tag-row">
                                                    @foreach (var item in GetBenchmarkKeywordChips(payload))
                                                    {
                                                        <span class="badge-neutral">@item</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (artifact.ArtifactType == "TopicPacket")
                                    {
                                        <div class="artifact-preview-grid">
                                            <div class="artifact-preview-block">
                                                <span class="label">Topic</span>
                                                <p>@GetJsonString(payload, "topic")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Primary keyword</span>
                                                <p>@GetJsonString(payload, "primaryKeyword")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Intent</span>
                                                <p>@GetJsonString(payload, "intent")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Pain point</span>
                                                <p>@GetJsonString(payload, "painPoint")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Goal</span>
                                                <p>@GetJsonString(payload, "goal")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Recommended angle</span>
                                                <p>@GetJsonString(payload, "recommendedAngle")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Summary</span>
                                                <p>@GetJsonString(payload, "summary")</p>
                                            </div>
                                            <div class="artifact-preview-block">
                                                <span class="label">Slug</span>
                                                <p>@GetJsonString(payload, "slug")</p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="artifact-placeholder">@artifact.ContentJson</div>
                                    }
                                </details>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        else if (ActiveTab == WorkflowTab.FinalArticle)
        {
            @if (FinalArticlePreview is null)
            {
                <section class="dashboard-card compact-card">
                    <div class="widget-title">Final Article</div>
                    <p class="text-center">No final article preview has been generated yet.</p>
                </section>
            }
            else
            {
                <section class="dashboard-card compact-card final-editor-shell">
                    <div class="widget-title">Editorial Mode</div>

                    @if (EditorModel is null)
                    {
                        <p class="text-center">Loading final article...</p>
                    }
                    else
                    {
                        <div class="editor-layout">
                            <div class="editor-main-pane">
                                <div class="editor-top-strip">
                                    <div class="editor-pill-row">
                                        @if (!string.IsNullOrWhiteSpace(EditorModel.ContentType))
                                        {
                                            <span class="editor-pill">@FormatLabel(EditorModel.ContentType)</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(EditorModel.PrimaryKeyword))
                                        {
                                            <span class="editor-pill editor-pill-muted">@EditorModel.PrimaryKeyword</span>
                                        }
                                    </div>
                                    <div class="editor-status-box">
                                        <span class="label">Status</span>
                                        <strong>@(Job?.Status ?? "Draft")</strong>
                                    </div>
                                </div>

                                <div class="editor-header-fields">
                                    <label class="editor-field">
                                        <span class="label">Title</span>
                                        <input @bind="EditorModel.Title" />
                                    </label>
                                    <label class="editor-field">
                                        <span class="label">Slug</span>
                                        <input @bind="EditorModel.Slug" />
                                    </label>
                                    <label class="editor-field full-span">
                                        <span class="label">Summary</span>
                                        <textarea @bind="EditorModel.Summary" rows="2"></textarea>
                                    </label>
                                </div>

                                <div id="@EditorElementId" class="contentos-editorjs-holder" data-editor-ready="false"></div>
                            </div>

                            <aside class="editor-sidebar-pane">
                                <div class="editor-sidebar-tabs">
                                    <button type="button" class="editor-sidebar-tab editor-sidebar-tab-active">SEO</button>
                                    <button type="button" class="editor-sidebar-tab">Research</button>
                                    <button type="button" class="editor-sidebar-tab">Media</button>
                                    <button type="button" class="editor-sidebar-tab">History</button>
                                </div>

                                <div class="editor-side-card">
                                    <div class="editor-side-title">Optimization</div>
                                    <div class="optimization-score-card">
                                        <div>
                                            <div class="optimization-score-label">Optimization Score</div>
                                            <div class="optimization-score-value">@SidebarOptimizationScore<span>/100</span></div>
                                            <div class="optimization-status-row">
                                                <span class="optimization-pill @SidebarOptimizationScoreClass">@SidebarOptimizationStatusLabel</span>
                                                <span class="optimization-pill @(SidebarPublishReady ? "optimization-score-strong" : "optimization-score-weak")">@(SidebarPublishReady ? "Publish Ready" : "Hold")</span>
                                            </div>
                                        </div>
                                        <div class="optimization-score-meter">
                                            <div class="optimization-score-fill @SidebarOptimizationScoreClass" style="width:@($"{SidebarOptimizationScore}%")"></div>
                                        </div>
                                    </div>
                                    <div class="editor-stats-grid optimization-breakdown-grid">
                                        <div class="editor-stat-card">
                                            <strong>@SidebarHighPriorityScore</strong>
                                            <span>High Priority</span>
                                            <small>Target 70+</small>
                                        </div>
                                        <div class="editor-stat-card">
                                            <strong>@SidebarLowPriorityScore</strong>
                                            <span>Low Priority</span>
                                            <small>Support score</small>
                                        </div>
                                        <div class="editor-stat-card">
                                            <strong>@SidebarStuffingRiskScore</strong>
                                            <span>Stuffing Risk</span>
                                            <small>@SidebarStuffingRiskLabel</small>
                                        </div>
                                        <div class="editor-stat-card">
                                            <strong>@SidebarStuffingPenaltyApplied</strong>
                                            <span>Penalty</span>
                                            <small>Applied to score</small>
                                        </div>
                                    </div>
                                    <div class="editor-stats-grid">
                                        <div class="editor-stat-card">
                                            <strong>@SidebarWordCount</strong>
                                            <span>Words</span>
                                            <small>@SidebarWordTargetLabel</small>
                                        </div>
                                        <div class="editor-stat-card">
                                            <strong>@SidebarMediaCount</strong>
                                            <span>Media</span>
                                            <small>@SidebarMediaTargetLabel</small>
                                        </div>
                                        <div class="editor-stat-card">
                                            <strong>@SidebarLinksCount</strong>
                                            <span>Links</span>
                                            <small>@SidebarLinksTargetLabel</small>
                                        </div>
                                        <div class="editor-stat-card">
                                            <strong>@SidebarChecklistCompleted</strong>
                                            <span>Checklist</span>
                                            <small>@SidebarChecklistTargetLabel</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="editor-side-card">
                                    <div class="editor-side-title">Keywords and Entities</div>
                                    <div class="keyword-chip-grid">
                                        @foreach (var chip in SidebarKeywordChips)
                                        {
                                            <div class="keyword-chip-card @MapKeywordChipClass(chip.Score)">
                                                <div class="keyword-chip-name">@chip.Keyword</div>
                                                <div class="keyword-chip-meta">@chip.ActualCount / @chip.TargetMin-@chip.TargetMax</div>
                                            </div>
                                        }
                                    </div>
                                    @if (SidebarMissingRelatedKeywords.Any())
                                    {
                                        <div class="optimization-list-block">
                                            <div class="optimization-list-title">Missing related keywords</div>
                                            <ul class="artifact-list">
                                                @foreach (var keyword in SidebarMissingRelatedKeywords)
                                                {
                                                    <li>@keyword</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    @if (SidebarOverusedKeywords.Any())
                                    {
                                        <div class="optimization-list-block">
                                            <div class="optimization-list-title">Overused keywords</div>
                                            <ul class="artifact-list">
                                                @foreach (var keyword in SidebarOverusedKeywords)
                                                {
                                                    <li>@keyword</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>

                                <div class="editor-side-card">
                                    <div class="editor-side-title">Visual Assets</div>
                                    <div class="editor-image-gallery">
                                        @foreach (var artifact in Artifacts?.Where(a => a.ArtifactType is "FeaturedImageAsset" or "SupportingImageAsset").OrderBy(a => a.CreatedUtc) ?? Enumerable.Empty<ContentArtifact>())
                                        {
                                            var payload = ParseArtifactJson(artifact.ContentJson);
                                            <div class="editor-image-asset">
                                                <div class="editor-image-preview">
