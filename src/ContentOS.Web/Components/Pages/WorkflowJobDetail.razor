    private void StartAutosaveTimer()
    {
        StopAutosaveTimer();
        _autosaveTimer = new Timer(async _ =>
        {
            await InvokeAsync(AutosaveEditorAsync);
        }, null, TimeSpan.FromSeconds(AutosaveIntervalSeconds), TimeSpan.FromSeconds(AutosaveIntervalSeconds));
    }

    private void StopAutosaveTimer()
    {
        _autosaveTimer?.Dispose();
        _autosaveTimer = null;
    }

    private async Task AutosaveEditorAsync()
    {
        if (EditorModel is null || FinalArticlePreview is null || IsSavingEditor) return;

        try
        {
            var editorJson = await JS.InvokeAsync<string>("contentOsEditor.getJson", EditorElementId);
            var editorHtml = await JS.InvokeAsync<string>("contentOsEditor.getHtml", EditorElementId);

            if (string.IsNullOrWhiteSpace(editorHtml)) return;

            // Skip if content hasn't changed since last save
            var currentSnapshot = editorHtml;
            if (currentSnapshot == _lastSavedHtml) return;
            _lastSavedHtml = currentSnapshot;

            EditorModel.BodyHtml = editorHtml;
            EditorModel.EditorJson = editorJson;
            EditorModel.EstimatedWordCount = CountWordsFromHtml(editorHtml).ToString();
            EditorModel.EstimatedReadTimeMinutes = Math.Max(1, (int)Math.Ceiling(CountWordsFromHtml(editorHtml) / 220m)).ToString();

            var payload = new FinalArticleArtifactPayload
            {
                Title = EditorModel.Title,
                Slug = EditorModel.Slug,
                PrimaryKeyword = EditorModel.PrimaryKeyword,
                KeywordStrengthLabel = EditorModel.KeywordStrengthLabel,
                KeywordStrengthScore = EditorModel.KeywordStrengthScore,
                KeywordStrengthReason = EditorModel.KeywordStrengthReason,
                ContentType = EditorModel.ContentType,
                Summary = EditorModel.Summary,
                MetaDescription = EditorModel.MetaDescription,
                TargetWordCountMin = EditorModel.TargetWordCountMin,
                TargetWordCountMax = EditorModel.TargetWordCountMax,
                EstimatedWordCount = EditorModel.EstimatedWordCount,
                EstimatedReadTimeMinutes = EditorModel.EstimatedReadTimeMinutes,
                CallToAction = EditorModel.CallToAction,
                HtmlBody = editorHtml,
                EditorJson = editorJson,
                ManuallyEdited = true
            };

            var contentJson = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
            var contentText = BuildPlainTextFromHtml(EditorModel.Title, EditorModel.Summary, EditorModel.BodyHtml, EditorModel.CallToAction);

            var success = await Mediator.Send(new UpdateContentArtifactCommand(
                EditorModel.ArtifactId,
                contentJson,
                contentText,
                "Autosave"));

            if (success)
            {
                FinalArticlePreview.ContentJson = contentJson;
                FinalArticlePreview.ContentText = contentText;
                EditorSaveMessage = $"Autosaved at {DateTime.UtcNow:HH:mm} UTC";
            }
        }
        catch
        {
            // Autosave failures are silent — don't disrupt the user
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void SetActiveTab(WorkflowTab tab)
