    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShouldHydrateEditor && EditorModel is not null)
        {
            ShouldHydrateEditor = false;
            var initData = !string.IsNullOrWhiteSpace(EditorModel.EditorJson) ? EditorModel.EditorJson : EditorModel.BodyHtml;
            try
            {
                await JS.InvokeVoidAsync("contentOsEditor.initWhenReady", EditorElementId, initData);
                StartAutosaveTimer();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ContentOS] Editor init failed: {ex.Message}");
            }
            StateHasChanged();
        }
