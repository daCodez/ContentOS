    private IEnumerable<KeywordChipViewModel> GetSidebarKeywordChips()
    {
        var articleText = GetKeywordTextSource();
        var serpPayload = ParseArtifactJson(LatestSerpBenchmark?.ContentJson);
        var optimizationPayload = ParseArtifactJson(LatestOptimizationReport?.ContentJson);

        if (serpPayload is not null)
        {
            var chips = new List<KeywordChipViewModel>();
            var primaryKeyword = GetJsonString(serpPayload, "query");
            var primaryMin = GetJsonInt(serpPayload, "recommendedPrimaryKeywordMin", 1);
            var primaryMax = GetJsonInt(serpPayload, "recommendedPrimaryKeywordMax", Math.Max(2, primaryMin + 1));

            if (!string.IsNullOrWhiteSpace(primaryKeyword))
            {
                var actualPrimaryCount = CountPhraseOccurrences(articleText, primaryKeyword);
                chips.Add(new KeywordChipViewModel
                {
                    Keyword = primaryKeyword,
                    ActualCount = actualPrimaryCount,
                    TargetMin = primaryMin,
                    TargetMax = primaryMax,
                    Score = ScoreRange(actualPrimaryCount, primaryMin, primaryMax)
                });
            }

            foreach (var related in GetSerpRelatedKeywordTargets(serpPayload).Take(7))
            {
                var actualCount = CountPhraseOccurrences(articleText, related.Keyword);
                chips.Add(new KeywordChipViewModel
                {
                    Keyword = related.Keyword,
                    ActualCount = actualCount,
                    TargetMin = related.TargetMin,
                    TargetMax = related.TargetMax,
                    Score = ScoreRange(actualCount, related.TargetMin, related.TargetMax)
                });
            }

            if (chips.Count > 0)
            {
                return chips;
            }
        }

        if (optimizationPayload is null)
        {
            var seoPayload = ParseArtifactJson(LatestSeoOptimization?.ContentJson);
            var keywordPayload = ParseArtifactJson(LatestKeywordStrategy?.ContentJson);
            var fallbackKeywords = new List<string>();

            if (seoPayload is not null)
            {
                fallbackKeywords.AddRange(GetJsonStringArray(seoPayload, "KeywordCluster", "keywordCluster"));
            }

            if (keywordPayload is not null)
            {
                fallbackKeywords.AddRange(GetJsonStringArray(keywordPayload, "KeywordVariations", "keywordVariations"));
            }

            return fallbackKeywords
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(8)
                .Select(keyword =>
                {
                    var actualCount = CountPhraseOccurrences(articleText, keyword);
                    return new KeywordChipViewModel
                    {
                        Keyword = keyword,
                        ActualCount = actualCount,
                        TargetMin = 1,
                        TargetMax = 2,
                        Score = ScoreRange(actualCount, 1, 2)
                    };
                })
                .ToList();
        }

        IEnumerable<KeywordChipViewModel> ReadChipArray(params string[] propertyNames)
        {
            foreach (var propertyName in propertyNames)
            {
                if (!TryGetProperty(payload: optimizationPayload.Value, propertyName, out var property) || property.ValueKind != JsonValueKind.Array)
                {
                    continue;
                }

                return property.EnumerateArray().Select(item => new KeywordChipViewModel
                {
                    Keyword = GetJsonString(item, "keyword"),
                    ActualCount = GetJsonInt(item, "actualCount", 0),
                    TargetMin = GetJsonInt(item, "targetMin", 0),
                    TargetMax = GetJsonInt(item, "targetMax", 0),
                    Score = GetJsonInt(item, "score", 0)
                }).Where(x => !string.IsNullOrWhiteSpace(x.Keyword));
            }

            return Enumerable.Empty<KeywordChipViewModel>();
        }

        return ReadChipArray("PrimaryKeywordChips", "primaryKeywordChips")
            .Concat(ReadChipArray("RelatedKeywordChips", "relatedKeywordChips"))
            .Take(8)
            .ToList();
    }

    private string GetKeywordTextSource()
    {
        if (!string.IsNullOrWhiteSpace(EditorModel?.BodyHtml))
        {
            return HtmlToPlainText(EditorModel.BodyHtml);
        }

        var payload = ParseArtifactJson(FinalArticlePreview?.ContentJson);
        if (payload is not null)
        {
            var htmlBody = GetJsonString(payload, "htmlBody");
            if (!string.IsNullOrWhiteSpace(htmlBody))
            {
                return HtmlToPlainText(htmlBody);
            }

            return HtmlToPlainText(BuildHtmlBody(payload));
        }

        var draftPayload = ParseArtifactJson(LatestDraftArticle?.ContentJson);
        if (draftPayload is not null)
        {
            var parts = new List<string>();
            parts.AddRange(GetJsonStringArray(draftPayload, "IntroParagraphs", "introParagraphs"));

            if (TryGetProperty(draftPayload.Value, "Sections", out var draftSections) || TryGetProperty(draftPayload.Value, "sections", out draftSections))
            {
                if (draftSections.ValueKind == JsonValueKind.Array)
                {
                    foreach (var section in draftSections.EnumerateArray())
                    {
                        var heading = GetJsonString(section, "Heading");
                        if (string.IsNullOrWhiteSpace(heading))
                        {
                            heading = GetJsonString(section, "heading");
                        }

                        if (!string.IsNullOrWhiteSpace(heading))
                        {
                            parts.Add(heading);
                        }

                        parts.AddRange(GetJsonStringArray(section, "Paragraphs", "paragraphs"));
                    }
                }
            }

            parts.AddRange(GetJsonStringArray(draftPayload, "ConclusionParagraphs", "conclusionParagraphs"));
            var cta = GetJsonString(draftPayload, "CallToAction");
            if (string.IsNullOrWhiteSpace(cta))
            {
                cta = GetJsonString(draftPayload, "callToAction");
            }

            if (!string.IsNullOrWhiteSpace(cta))
            {
                parts.Add(cta);
            }

            return string.Join(" ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
        }

        return string.Empty;
    }

    private IEnumerable<KeywordChipViewModel> GetSerpRelatedKeywordTargets(JsonElement? payload)
    {
        if (payload is null)
        {
            return Enumerable.Empty<KeywordChipViewModel>();
        }

        if (TryGetProperty(payload.Value, "relatedKeywords", out var relatedKeywords) && relatedKeywords.ValueKind == JsonValueKind.Array)
        {
            var explicitKeywords = relatedKeywords.EnumerateArray()
                .Select(item => new KeywordChipViewModel
                {
                    Keyword = GetJsonString(item, "keyword"),
                    TargetMin = GetJsonInt(item, "recommendedMin", 1),
                    TargetMax = GetJsonInt(item, "recommendedMax", 2)
                })
                .Where(x => !string.IsNullOrWhiteSpace(x.Keyword))
                .ToList();

            if (explicitKeywords.Count > 0)
            {
                return explicitKeywords;
            }
        }

        if (!TryGetProperty(payload.Value, "results", out var results) || results.ValueKind != JsonValueKind.Array)
        {
            return Enumerable.Empty<KeywordChipViewModel>();
        }

        var primaryTerms = (GetJsonString(payload, "query") ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(x => x.ToLowerInvariant())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var stopWords = new HashSet<string>(new[]
        {
            "what", "with", "from", "that", "this", "into", "your", "about", "guide", "complete", "blog", "learn", "work", "works", "using", "zero", "based", "budgeting"
        }, StringComparer.OrdinalIgnoreCase);

        var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var item in results.EnumerateArray())
        {
            var title = GetJsonString(item, "title");
            foreach (var token in System.Text.RegularExpressions.Regex.Matches(title.ToLowerInvariant(), "[a-z]{4,}")
                         .Select(x => x.Value)
                         .Where(x => !stopWords.Contains(x) && !primaryTerms.Contains(x)))
            {
                counts[token] = counts.TryGetValue(token, out var value) ? value + 1 : 1;
            }
        }

        return counts
            .OrderByDescending(x => x.Value)
            .ThenBy(x => x.Key)
            .Take(7)
            .Select(x => new KeywordChipViewModel
            {
                Keyword = x.Key,
                TargetMin = 1,
                TargetMax = Math.Max(2, x.Value),
                Score = 0
            })
            .ToList();
    }

    private static string HtmlToPlainText(string html)
    {
        var plain = System.Text.RegularExpressions.Regex.Replace(html ?? string.Empty, "<[^>]+>", " ");
        plain = System.Net.WebUtility.HtmlDecode(plain);
        return System.Text.RegularExpressions.Regex.Replace(plain, @"\s+", " ").Trim();
    }

    private static int CountPhraseOccurrences(string content, string phrase)
    {
        if (string.IsNullOrWhiteSpace(content) || string.IsNullOrWhiteSpace(phrase))
        {
            return 0;
        }

        return System.Text.RegularExpressions.Regex.Matches(content, $@"(?i)\b{System.Text.RegularExpressions.Regex.Escape(phrase)}\b").Count;
    }

    private static int ScoreRange(int actual, int min, int max)
    {
        if (min <= 0 && max <= 0) return 0;
        if (actual >= min && actual <= max) return 100;
        if (actual < min) return (int)Math.Max(0, Math.Min(100, Math.Round((decimal)actual / Math.Max(1, min) * 100m)));
        var overflow = actual - max;
        var penalty = Math.Min(100m, ((decimal)overflow / Math.Max(1, max)) * 100m);
        return (int)Math.Max(0, Math.Round(100m - penalty));
    }

    private static string MapKeywordChipClass(int score)
        => score >= 90 ? "keyword-chip-strong"
            : score >= 70 ? "keyword-chip-medium"
            : "keyword-chip-weak";

    private static string MapKeywordStrengthClass(string value)
        => value switch
        {
            "Very Strong" => "keyword-strength-strong",
            "Strong" => "keyword-strength-strong",
            "Moderate" => "keyword-strength-moderate",
            "Weak" => "keyword-strength-weak",
            "Very Weak" => "keyword-strength-weak",
            _ => string.Empty
        };

    private static string MapJobStatusClass(string status)
        => status == "Completed" ? "status-approved"
         : status == "InProgress" ? "status-ready"
         : status == "Blocked" || status == "Failed" ? "status-danger"
         : "status-pending";

    private static string MapTaskStatusClass(TaskStatusEnum status)
        => status == TaskStatusEnum.Completed ? "status-approved"
         : status == TaskStatusEnum.Ready || status == TaskStatusEnum.InProgress ? "status-ready"
         : status == TaskStatusEnum.Blocked || status == TaskStatusEnum.Failed ? "status-danger"
         : "status-pending";

