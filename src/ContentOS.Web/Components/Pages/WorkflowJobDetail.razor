    private string BuildHtmlBody(JsonElement? payload)
    {
        if (payload is null)
        {
            return string.Empty;
        }

        var imageBlocks = GetGeneratedImageHtmlBlocks().ToList();
        var blocks = new List<string>();
        blocks.AddRange(GetArticleParagraphs(payload, "introParagraphs", "intro").Select(RenderHtmlBlock));

        var sections = GetFinalArticleSections(payload).ToList();
        if (sections.Count > 0)
        {
            blocks.Add("<section class=\"article-read-section article-read-toc\"><h2>Table of Contents</h2><ul>" +
                       string.Join(string.Empty, sections.Select(section => $"<li><a href=\"#{BuildAnchorId(section.Heading)}\">{System.Net.WebUtility.HtmlEncode(section.Heading)}</a></li>")) +
                       "<li><a href=\"#conclusion\">Conclusion</a></li><li><a href=\"#next-step\">Next step</a></li></ul></section>");
        }

        if (imageBlocks.Count > 0)
        {
            blocks.Add(imageBlocks[0]);
        }

        var supportingImageIndex = 1;
        for (var index = 0; index < sections.Count; index++)
        {
            var section = sections[index];
            blocks.Add($"<section class=\"article-read-section\" id=\"{BuildAnchorId(section.Heading)}\"><h2>{System.Net.WebUtility.HtmlEncode(section.Heading)}</h2>{string.Join(string.Empty, section.Paragraphs.Select(RenderHtmlBlock))}</section>");

            if (supportingImageIndex < imageBlocks.Count)
            {
                blocks.Add(imageBlocks[supportingImageIndex]);
                supportingImageIndex++;
            }
        }

        var conclusion = GetArticleParagraphs(payload, "conclusionParagraphs", "conclusion").ToList();
        if (conclusion.Any())
        {
            blocks.Add($"<section class=\"article-read-section\" id=\"conclusion\"><h2>Conclusion</h2>{string.Join(string.Empty, conclusion.Select(RenderHtmlBlock))}</section>");
        }

        if (!string.IsNullOrWhiteSpace(GetJsonString(payload, "callToAction")))
        {
            blocks.Add($"<section class=\"article-read-section\" id=\"next-step\"><h2>Next step</h2>{RenderHtmlBlock(GetJsonString(payload, "callToAction"))}</section>");
        }

        return string.Join("\n", blocks);
    }

    private static string RenderHtmlBlock(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        var lines = text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length > 0 && lines.All(line => line.StartsWith("- ", StringComparison.Ordinal)))
        {
            return "<ul>" + string.Join(string.Empty, lines.Select(line => $"<li>{FormatInlineMarkup(line[2..])}</li>")) + "</ul>";
        }

        if (lines.Length > 0 && lines.All(line => System.Text.RegularExpressions.Regex.IsMatch(line, "^\\d+\\.\\s")))
        {
            return "<ol>" + string.Join(string.Empty, lines.Select(line => $"<li>{FormatInlineMarkup(System.Text.RegularExpressions.Regex.Replace(line, "^\\d+\\.\\s", string.Empty))}</li>")) + "</ol>";
        }

        return $"<p>{FormatInlineMarkup(text)}</p>";
    }

    private static string FormatInlineMarkup(string text)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        return System.Text.RegularExpressions.Regex.Replace(encoded, "\\*\\*(.+?)\\*\\*", "<strong>$1</strong>");
    }

    private static string BuildAnchorId(string heading)
        => System.Text.RegularExpressions.Regex.Replace((heading ?? string.Empty).ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    private IEnumerable<string> GetGeneratedImageHtmlBlocks()
    {
        return (Artifacts ?? [])
            .Where(x => x.ArtifactType is "FeaturedImageAsset" or "SupportingImageAsset")
            .OrderBy(x => x.ArtifactType == "FeaturedImageAsset" ? 0 : 1)
            .ThenBy(x => x.CreatedUtc)
            .Select(x => ParseArtifactJson(x.ContentJson))
            .Where(x => x is not null)
            .Select(payload => new
            {
                ImagePath = GetJsonString(payload, "imagePath"),
                AltText = GetJsonString(payload, "altText"),
                Title = GetJsonString(payload, "title")
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.ImagePath))
            .Select(x => $"<figure class=\"article-inline-image\"><img src=\"{EscapeHtmlAttribute(x.ImagePath)}\" alt=\"{EscapeHtmlAttribute(x.AltText)}\" /><figcaption>{System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(x.Title) ? x.AltText : x.Title)}</figcaption></figure>");
    }

    private static string BuildPlainTextFromHtml(string title, string summary, string html, string callToAction)
    {
        var plainBody = System.Text.RegularExpressions.Regex.Replace(html ?? string.Empty, "<[^>]+>", " ");
        plainBody = System.Net.WebUtility.HtmlDecode(plainBody);
        plainBody = System.Text.RegularExpressions.Regex.Replace(plainBody, @"\s+", " ").Trim();
        return string.Join("\n\n", new[] { title, summary, plainBody, callToAction }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static int CountWordsFromHtml(string html)
    {
        var plain = System.Text.RegularExpressions.Regex.Replace(html ?? string.Empty, "<[^>]+>", " ");
        plain = System.Net.WebUtility.HtmlDecode(plain);
        return plain.Split([' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private static int CountLinksFromHtml(string html)
        => string.IsNullOrWhiteSpace(html)
            ? 0
            : System.Text.RegularExpressions.Regex.Matches(html, "<a\\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Count;

    private int CountChecklistCompleted()
    {
        if (EditorModel is null)
        {
            return 0;
        }

        var completed = 0;
        if (!string.IsNullOrWhiteSpace(EditorModel.Title)) completed++;
        if (!string.IsNullOrWhiteSpace(EditorModel.Slug)) completed++;
        if (!string.IsNullOrWhiteSpace(EditorModel.MetaDescription)) completed++;
        if (EditorWordCount >= SafeInt(EditorModel.TargetWordCountMin, 0)) completed++;
        if (!string.IsNullOrWhiteSpace(EditorModel.PrimaryKeyword)) completed++;
        return completed;
    }

    private int CalculateOptimizationScore()
    {
        if (EditorModel is null)
        {
            return 0;
        }

        var score = 0;
        if (!string.IsNullOrWhiteSpace(EditorModel.Title)) score += 20;
        if (!string.IsNullOrWhiteSpace(EditorModel.Slug)) score += 15;
        if (!string.IsNullOrWhiteSpace(EditorModel.MetaDescription)) score += 15;
        if (!string.IsNullOrWhiteSpace(EditorModel.PrimaryKeyword)) score += 15;
        if (!string.IsNullOrWhiteSpace(EditorModel.KeywordStrengthLabel)) score += 10;

        var targetMin = SafeInt(EditorModel.TargetWordCountMin, 0);
        var targetMax = SafeInt(EditorModel.TargetWordCountMax, 0);
        if (EditorWordCount >= targetMin && (targetMax == 0 || EditorWordCount <= targetMax + 300))
        {
            score += 15;
        }
        else if (EditorWordCount >= Math.Max(1, targetMin - 300))
        {
            score += 8;
        }

        if (ChecklistCompleted >= 4) score += 10;
        return Math.Min(100, score);
    }

    private static int SafeInt(string value, int fallback)
        => int.TryParse(value, out var parsed) ? parsed : fallback;

    private static string FormatJsonBlock(string? value)
    {
        return string.IsNullOrWhiteSpace(value) || value == "{}"
            ? "No output generated yet."
            : value;
    }

    private int CountTasksByStatus(TaskStatusEnum status)
